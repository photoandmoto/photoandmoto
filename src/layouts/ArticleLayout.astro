---
import BaseLayout from './BaseLayout.astro';
import { ui } from '../i18n/ui';

interface Props {
  frontmatter: {
    title: string;
    subtitle?: string;
    author: string;
    date: Date;
    category: string;
    tags: string[];
    featured_image: string;
    show_hero?: boolean;
    image_caption?: string;
    language?: 'fi' | 'en';
    seo_description?: string;
    author_url?: string;
    sources?: string | null;
  };
  lang: 'fi' | 'en';
}

const { frontmatter, lang } = Astro.props;
const t = ui[lang];

// Render sources field with HTML escaping + URL auto-linking. Renders only if
// non-empty. set:html below requires a pre-escaped string.
function renderSources(text: string): string {
  const escaped = text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
  return escaped.replace(
    /(https?:\/\/[^\s<]+)/g,
    '<a href="$1" target="_blank" rel="noopener noreferrer">$1</a>'
  );
}
const sourcesHtml = frontmatter.sources ? renderSources(frontmatter.sources) : null;

const formattedDate = new Intl.DateTimeFormat(lang === 'fi' ? 'fi-FI' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}).format(frontmatter.date);

const _siteUrl = import.meta.env.SITE || 'https://www.photoandmoto.fi';

// Prefer the auto-generated OG card at /og/<slug>-<lang>.jpg over the raw
// featured_image. The card is a 1200x630 branded composite (title, category,
// Photo & Moto wordmark) generated by .github/workflows/generate-og-images.yml
// on every article push. Falls back to featured_image then the site default.
const _slugMatch = Astro.url.pathname.match(/\/(?:aikakone|time-machine)\/([^/]+)/);
const _ogCardPath = _slugMatch ? `/og/${_slugMatch[1]}-${lang}.jpg` : null;
const _ogImage = _ogCardPath
  || frontmatter.featured_image
  || '/images/og-default.jpg';
const _articleImage = _ogImage.startsWith('http') ? _ogImage : _siteUrl + _ogImage;
const _articleUrl = _siteUrl + Astro.url.pathname.replace(/\/+$/, '');
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": frontmatter.title,
  "description": frontmatter.seo_description || frontmatter.subtitle || frontmatter.title,
  "image": _articleImage,
  "datePublished": frontmatter.date.toISOString(),
  "dateModified": frontmatter.date.toISOString(),
  "author": {
    "@type": "Person",
    "name": frontmatter.author,
    "url": frontmatter.author_url || (_siteUrl + "/" + lang + "/yhteystiedot/")
  },
  "publisher": {
    "@type": "Organization",
    "name": "Photo & Moto",
    "logo": { "@type": "ImageObject", "url": _siteUrl + "/favicon.png" }
  },
  "mainEntityOfPage": { "@type": "WebPage", "@id": _articleUrl },
  "inLanguage": lang === 'fi' ? 'fi-FI' : 'en-US',
  "articleSection": frontmatter.category,
  "keywords": (frontmatter.tags || []).join(', ')
};
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.seo_description || frontmatter.subtitle || frontmatter.title}
  image={_ogImage}
  lang={lang}
>
  <article class="article" data-pagefind-body data-pagefind-meta="type:article">
    <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    <div class="container">
      <header class="article-header">
        <a href={lang === 'fi' ? '/fi/aikakone' : '/en/time-machine'} class="back-link">
          {lang === 'fi' ? '← Takaisin artikkeleihin' : '← Back to articles'}
        </a>
        
        <div class="article-meta-top">
          <span class="badge">{frontmatter.category}</span>
          <span class="meta-date">{formattedDate}</span>
        </div>
        
        <h1 class="article-title">{frontmatter.title}</h1>
        
        {frontmatter.subtitle && (
          <p class="article-subtitle">{frontmatter.subtitle}</p>
        )}
      </header>
      
      {frontmatter.featured_image && frontmatter.show_hero !== false && (
        <div class="article-hero">
          <img 
            src={frontmatter.featured_image} 
            alt={frontmatter.image_caption || frontmatter.title}
          />
          {frontmatter.image_caption && (
            <figcaption>{frontmatter.image_caption}</figcaption>
          )}
        </div>
      )}
      
      <div class="article-body">
        <slot />
      </div>

      {sourcesHtml && (
        <aside class="article-sources">
          <h3 class="article-sources__heading">
            {lang === 'fi' ? 'Lähteet' : 'Sources'}
          </h3>
          <div class="article-sources__body" set:html={sourcesHtml} />
        </aside>
      )}

      <footer class="article-footer">
        <div class="author-info">
          <strong>{t['article.author']}:</strong> {frontmatter.author}
        </div>
        {frontmatter.tags.length > 0 && (
          <div class="article-tags">
            {frontmatter.tags.map(tag => (
              <span class="tag">#{tag}</span>
            ))}
          </div>
        )}
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .article {
    padding: var(--space-6) 0;
  }
  
  .article .container {
    max-width: 1000px;
  }
  
  /* Header */
  .article-header {
    margin-bottom: var(--space-5);
  }
  
  .back-link {
    display: inline-block;
    font-family: var(--font-headline);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    /* AA-amber (#A85D00 ~5:1) instead of bright #ff9900 (~2:1). */
    color: #A85D00;
    margin-bottom: var(--space-3);
    transition: color var(--transition-fast);
  }
  .back-link:hover {
    color: var(--brand-secondary);
    text-decoration: underline;
  }
  
  .article-meta-top {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }
  
  .meta-date {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }
  
  .article-title {
    font-size: clamp(2rem, 5vw, 3rem);
    color: var(--text-primary);
    margin-bottom: var(--space-2);
    line-height: 1.1;
  }
  
  .article-subtitle {
    font-size: 1.6rem;
    color: var(--text-primary);
    font-style: normal;
    font-weight: 600;
    margin-bottom: 0;
    line-height: 1.3;
  }
  
  /* Hero image */
  .article-hero {
    margin-bottom: var(--space-6);
    border-radius: var(--radius-md);
    max-width: 60%;
    margin-left: auto;
    margin-right: auto;
    overflow: hidden;
  }
  
  .article-hero img {
    width: 100%;
    height: auto;
    display: block;
  }
  
  .article-hero figcaption {
    padding: var(--space-2);
    background: var(--bg-secondary);
    font-size: 0.85rem;
    color: var(--text-secondary);
    text-align: center;
    font-style: italic;
  }
  
  /* Two-column article body */
  .article-body {
    max-width: 760px;
    margin: 0 auto;
    font-size: 1.05rem;
    line-height: 1.75;
  }
  
  .article-body :global(p) {
    margin-bottom: var(--space-3);
  }

  /* Lists need the same breathing room after the last item */
  .article-body :global(ul),
  .article-body :global(ol) {
    margin-bottom: var(--space-3);
    padding-left: var(--space-3);
  }
  .article-body :global(li) {
    margin-bottom: 4px;
  }

  /* Horizontal rules — visible thin orange-tinted divider */
  .article-body :global(hr) {
    border: none;
    border-top: 2px solid #e8e0d6;
    margin: var(--space-5) auto;
    width: 60%;
  }

  /* Headings as callout style */
  .article-body :global(h2) {
    font-family: var(--font-headline);
    font-size: 1.4rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-primary);
    border-left: 4px solid #ff9900;
    padding-left: var(--space-2);
    margin-top: var(--space-5);
    margin-bottom: var(--space-3);


  }
  
  .article-body :global(h3) {
    font-size: 1.2rem;
    color: var(--brand-secondary);
    margin-top: var(--space-4);
    margin-bottom: var(--space-2);


  }
  
  /* Blockquotes as callout boxes */
  .article-body :global(blockquote) {

    margin: var(--space-4) 0;
    padding: var(--space-3);
    padding-left: 1.25rem;
    background: var(--bg-secondary);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--text-primary);
  }
  
  .article-body :global(blockquote p) {
    margin-bottom: 0;
  }
  
  /* Bold text */
  .article-body :global(strong) {
    font-weight: 700;
    color: var(--text-primary);
  }
  
  /* Emphasis / italic */
  .article-body :global(em) {
    font-style: italic;
    color: var(--text-secondary);
  }

  /* Inline links in article body. These had no dedicated rule and fell back to
     the global orange (#ff9900, ~2:1 on white — fails AA) with no underline, so
     readers couldn't reliably tell text was a link. Now: AA-amber + underline
     (color alone is insufficient per WCAG 1.4.1), with clear hover/focus. */
  .article-body :global(a) {
    color: #A85D00;
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color var(--transition-fast);
  }
  .article-body :global(a:hover) {
    color: var(--brand-secondary);
    text-decoration-thickness: 2px;
  }
  
  /* Images in article */
  /* Tables */
  .article-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-4) 0;
    font-size: 0.9rem;
  }
  
  .article-body :global(thead) {
    background: #000000;
    color: white;
  }
  
  .article-body :global(th) {
    font-family: var(--font-headline);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 10px 12px;
    text-align: left;
    font-weight: 700;
  }
  
  .article-body :global(td) {
    padding: 8px 12px;
    border-bottom: 1px solid #eee;
  }
  
  .article-body :global(tr:nth-child(even)) {
    background: var(--bg-secondary);
  }
  
  /* Note: previously had `tr:first-child td { color: brand-primary }` which
     was meant for header-less <table> markup but broke any table with a
     proper <thead> by colouring the first DATA row orange. Removed —
     tables with <thead> now use the dedicated thead/th rules above. */

  .article-body :global(img) {
    max-width: 400px;
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    margin: var(--space-4) auto;
    display: block;
  }

  /* Body images with a markdown title -> <figure> + <figcaption> (built by the
     rehypeFigureFromTitle plugin in astro.config.mjs). Slotted content, so the
     selectors must be :global. */
  .article-body :global(.article-figure) {
    max-width: 560px;
    margin: var(--space-4) auto var(--space-2);
    display: block;
  }
  .article-body :global(.article-figure img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    display: block;
    margin: 0;
  }
  .article-body :global(.article-figure figcaption) {
    font-size: 0.8rem;
    color: var(--text-secondary);
    font-style: italic;
    text-align: center;
    padding-top: 6px;
    line-height: 1.4;
  }

  /* Sources block (Lähteet) — appears at the end of the body, before the footer */
  .article-sources {
    max-width: 760px;
    margin: var(--space-5) auto 0;
    padding: var(--space-3);
    background: var(--bg-secondary);
    border-left: 4px solid var(--brand-primary);
    font-size: 0.9rem;
    color: var(--text-secondary);
  }
  .article-sources__heading {
    font-family: var(--font-headline);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-primary);
    margin: 0 0 var(--space-2);
  }
  .article-sources__body {
    white-space: pre-line;
    line-height: 1.6;
    word-break: break-word;
  }
  .article-sources__body a {
    color: var(--brand-primary);
    text-decoration: underline;
  }
  .article-sources__body a:hover {
    text-decoration: none;
  }

  /* Footer */
  .article-footer {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 2px solid var(--bg-secondary);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  
  .author-info {
    font-size: 0.95rem;
    color: var(--text-secondary);
  }
  
  .article-tags {
    display: flex;
    gap: var(--space-1);
    flex-wrap: wrap;
  }
  
  .tag {
    font-size: 0.85rem;
    /* AA-amber for the #tag labels (decorative, but keep legible). */
    color: #A85D00;
    font-weight: 600;
  }
  
  /* Mobile: single column */
  @media (max-width: 768px) {
    .article-footer {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  /* Split-table — two tables side by side (markdown-injected, needs :global) */
  :global(.split-table) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4, 1rem);
    margin: var(--space-6, 2rem) 0 0 0;
  }
  :global(.split-table table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    margin: 0 !important;
  }
  :global(.split-table th),
  :global(.split-table td) {
    padding: 6px 10px;
    border-bottom: 1px solid rgba(0,0,0,0.08);
    text-align: left;
  }
  :global(.split-table th) {
    background: #000 !important;
    color: #fff !important;
    font-weight: 600 !important;
  }
  /* Force ALL body cells to black, normal weight — overrides generic article styles */
  :global(.split-table tbody td),
  :global(.split-table tbody tr td),
  :global(.split-table tbody tr:first-child td),
  :global(.split-table tbody tr:nth-child(1) td),
  :global(.split-table tbody tr:first-child td strong),
  :global(.split-table tbody td strong) {
    color: #000 !important;
    font-weight: 400 !important;
  }
  :global(.split-table tbody tr:nth-child(odd)) {
    background: rgba(0,0,0,0.02);
  }
  @media (max-width: 720px) {
    :global(.split-table) {
      grid-template-columns: 1fr;
    }
  }

</style>
