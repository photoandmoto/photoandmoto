---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrendingTicker from '../../components/TrendingTicker.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import LatestSidebar from '../../components/LatestSidebar.astro';
import UpcomingRaces from '../../components/UpcomingRaces.astro';
import RotatingHeroSplit from '../../components/RotatingHeroSplit.astro';
import MysteryHelpBlock from '../../components/MysteryHelpBlock.astro';
import { getCollection } from 'astro:content';
import { ui } from '../../i18n/ui';

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

const lang = 'en';
const t = ui[lang];

const articles = (await getCollection('articles', (entry) =>
  entry.id.startsWith('en/') && !entry.data.draft
)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const slugFor = (a) => `/en/time-machine/${a.id.replace(/^en\//, '')}`;
const imgFor = (a) => a.data.card_image || a.data.featured_image;
const focusFor = (a) => a.data.card_image ? a.data.card_image_focus : a.data.featured_image_focus;

// Featured hero + sidebar: 1 hero article + 5 sidebar articles (1 lead + 4 compact rows)
const featuredArticle = articles[0];
const sidebarArticles = articles.slice(1, 6);
const sidebarItems = sidebarArticles.map(a => ({
  href: slugFor(a),
  image: imgFor(a),
  title: a.data.title,
  subtitle: fmt(a.data.date),
  category: a.data.category,
  focus: focusFor(a),
}));

const tickerItems = articles.slice(0, 5).map(a => ({
  href: slugFor(a),
  title: a.data.title,
}));

const galleries = await getCollection('galleries');
const featuredGalleries = galleries.slice(0, 4);

// Build items array for galleries
const galleryItems = featuredGalleries.map(g => ({
  href: `/en/gallery/${g.data.slug}`,
  image: `/galleries/${g.data.slug}/${g.data.cover_image}`,
  title: g.data.title,
  subtitle: t['gallery.photoCount'].replace('{count}', g.data.images.length.toString()),
}));
---

<BaseLayout
  title="Home"
  lang={lang}
  description="Motocross and motorcycle sport photos, stories and race results from the 1960s to today. MXGP 2026, Time Machine archive and photo gallery."
  showHeaderTicker={false}
>

  <h1 class="sr-only">Photo & Moto — Speed and Life Through the Lens</h1>
  <div class="ticker-band">
    <TrendingTicker label="Trending now" items={tickerItems} intervalMs={3000} />
  </div>

  {/* ===== Featured hero + sidebar (articles) ===== */}
  {featuredArticle && (
    <section class="section featured-grid-section">
      <div class="container">
        <div class="section-header-row">
          <h2 class="section-heading">Latest articles</h2>
          <a href="/en/time-machine" class="section-all-link">All articles →</a>
        </div>
        <div class="featured-row">
          <ArticleCard
            href={slugFor(featuredArticle)}
            image={imgFor(featuredArticle)}
            category={featuredArticle.data.category}
            title={featuredArticle.data.title}
            subtitle={featuredArticle.data.subtitle}
            size="lg"
            textBelow
            focus={focusFor(featuredArticle)}
          />
          {sidebarItems.length > 0 && (
            <LatestSidebar items={sidebarItems} />
          )}
        </div>
      </div>
    </section>
  )}

  {/* ===== Upcoming races band ===== */}
  <UpcomingRaces lang="en" />

  {/* ===== Gallery section (rotating 1 big + 3 stacked) ===== */}
  {featuredGalleries.length > 0 && (
    <section class="section gallery-section">
      <div class="container">
        <div class="section-header-row">
          <h2 class="section-heading">Gallery</h2>
          <a href="/en/gallery" class="section-all-link">All galleries →</a>
        </div>
        <RotatingHeroSplit items={galleryItems} variant="sidebar" />
      </div>
    </section>
  )}

  {/* ===== Mystery photo help block — appears only when unidentified photos exist ===== */}
  <MysteryHelpBlock lang="en" />

  {/* ===== Contact CTA section ===== */}
  <section class="section cta-section">
    <div class="container">
      <h2 class="cta-section__heading">Get in touch</h2>
      <div class="cta-grid">
        <a href="/en/yhteystiedot" class="cta-card">
          <h3 class="cta-card__heading">Photo usage</h3>
          <p class="cta-card__body">Want to use our photos? We handle requests on a case-by-case basis.</p>
        </a>
        <a href="/en/yhteystiedot" class="cta-card">
          <h3 class="cta-card__heading">Questions</h3>
          <p class="cta-card__body">Something on your mind? We might have the answer.</p>
        </a>
        <a href="/en/yhteystiedot" class="cta-card">
          <h3 class="cta-card__heading">Stories</h3>
          <p class="cta-card__body">Share a related story as our article.</p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Section shared */
  .section-header-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-4);
    gap: var(--space-3);
  }

  .section-heading {
    font-family: var(--font-headline);
    font-size: 1.75rem;
    font-weight: 900;
    color: var(--text-primary);
    margin: 0;
  }

  .section-all-link {
    font-family: var(--font-headline);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    /* Darker amber than --brand-primary (#ff9900). The bright brand orange is
       ~2:1 on white/#F9F9F9 — fails WCAG AA for small text. #A85D00 gives
       ~4.8:1 while staying in the orange family. Scoped to this link only;
       --brand-primary is unchanged for fills/borders/large headings. */
    color: #A85D00;
    text-decoration: none;
    white-space: nowrap;
  }
  .section-all-link:hover {
    text-decoration: underline;
  }

  /* Ticker — relocated out of the header, now its own strip flush against
     the nav bar (no seam between the nav's orange border and the ticker's
     black background). Spacing is kept only below, before "Latest
     articles". */
  .ticker-band {
    margin: 0 0 var(--space-3);
  }

  /* ===== Featured hero + sidebar layout ===== */
  .featured-row {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: var(--space-3);
    align-items: stretch;
  }

  .featured-row > article {
    min-height: 420px;
  }

  /* Articles section */
  .featured-grid-section {
    background: var(--bg-secondary);
    padding-top: var(--space-8);
    padding-bottom: var(--space-6);
  }

  /* Gallery section */
  .gallery-section {
    background: var(--bg-secondary);
    padding: var(--space-6) 0;
  }


  /* ===== CTA section ===== */
  .section.cta-section {
    background: var(--bg-secondary);
    padding: var(--space-4) 0;
  }

  .cta-section__heading {
    font-family: var(--font-headline);
    font-size: 1.75rem;
    font-weight: 900;
    color: var(--text-primary);
    margin: 0 0 var(--space-4);
  }

  .cta-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }

  .cta-card {
    display: block;
    background: #0e0e0e;
    border-radius: var(--radius-md);
    padding: var(--space-4);
    text-decoration: none;
    transition: transform 0.2s ease, background 0.2s ease;
    border: 1px solid rgba(255, 153, 0, 0.15);
  }

  .cta-card:hover {
    transform: translateY(-2px);
    background: #1a1a1a;
    border-color: rgba(255, 153, 0, 0.4);
  }

  .cta-card__heading {
    font-family: var(--font-headline);
    font-size: 1.2rem;
    font-weight: 900;
    color: var(--brand-primary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin: 0 0 var(--space-2);
    line-height: 1.2;
  }

  .cta-card__body {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.5;
    margin: 0;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .featured-row {
      grid-template-columns: 1fr;
    }
    .featured-row > article {
      min-height: 320px;
    }
    .cta-grid {
      grid-template-columns: 1fr;
    }
    .cta-section {
      padding: var(--space-8) 0;
    }
  }

  @media (max-width: 540px) {
    .section-heading {
      font-size: 1.4rem;
    }
  }
</style>
