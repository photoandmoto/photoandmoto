---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

const lang = 'fi';
const fmt = (d: Date) =>
  d.toLocaleDateString('fi-FI', { day: 'numeric', month: 'numeric', year: 'numeric' });

// FI-only collection. Show only published (draft: false), newest first, latest
// 10. Older pikauutiset stay in the collection (archived in git) but aren't
// listed here.
const published = (await getCollection('pikauutiset', (e) => !e.data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latest = published.slice(0, 10);

// First complete sentence of the body — shown in the collapsed card. Ends at
// the first . ! or ? followed by a space or the end of the string.
function extractFirstSentence(md: string) {
  const text = String(md || '').replace(/[#>*_`~]/g, '').replace(/\s+/g, ' ').trim();
  if (!text) return '';
  const m = text.match(/^.*?[.!?](?=\s|$)/);
  return (m ? m[0] : text).trim();
}

// Body (2–3 sentences) is the markdown content area — render each entry.
const items = await Promise.all(
  latest.map(async (e) => {
    const { Content } = await render(e);
    return { data: e.data, Content, firstSentence: extractFirstSentence(e.body || '') };
  })
);
---
<BaseLayout
  title="Pikauutiset"
  lang={lang}
  description="Lyhyet uutissalamat moottoriurheilun maailmasta — MXGP, speedway, enduro, historia ja tekniikka."
>
  <section class="pk">
    <div class="container">
      <div class="pk-head">
        <h1 class="pk-title">Pikauutiset</h1>
        <p class="pk-intro">Lyhyet uutiset moottoriurheilun maailmasta.</p>
      </div>

      {items.length === 0 ? (
        <p class="pk-empty">Ei vielä pikauutisia. Palaa pian uudelleen!</p>
      ) : (
        <div class="pk-list">
          {items.map((item) => (
            <article class="pk-card" data-expanded="false">
              <button type="button" class="pk-card__head" aria-expanded="false">
                {item.data.photo ? (
                  <span class="pk-card__thumb"><img src={item.data.photo} alt={item.data.title} loading="lazy" /></span>
                ) : (
                  <span class="pk-card__thumb pk-card__thumb--empty" aria-hidden="true">📰</span>
                )}
                <span class="pk-card__headtext">
                  <span class="pk-card__meta">
                    <time datetime={item.data.date.toISOString().slice(0, 10)}>{fmt(item.data.date)}</time>
                    <span class="pk-card__dot" aria-hidden="true">·</span>
                    <span class="pk-card__author">{item.data.author}</span>
                  </span>
                  <span class="pk-card__title">{item.data.title}</span>
                  {item.firstSentence && <span class="pk-card__preview">{item.firstSentence}</span>}
                </span>
                <span class="pk-card__chev" aria-hidden="true">▾</span>
              </button>
              <div class="pk-card__panel">
                <div class="pk-card__text"><item.Content /></div>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  // Collapsible cards — click/tap the header to expand/collapse the body.
  document.querySelectorAll('.pk-card__head').forEach((head) => {
    head.addEventListener('click', () => {
      const card = head.closest('.pk-card');
      const open = card.getAttribute('data-expanded') === 'true';
      card.setAttribute('data-expanded', open ? 'false' : 'true');
      head.setAttribute('aria-expanded', open ? 'false' : 'true');
    });
  });
</script>

<style>
  .pk { padding: var(--space-5, 3rem) 0; }
  .pk-head { margin-bottom: 28px; }
  .pk-title { font-family: var(--font-headline); font-size: 2rem; font-weight: 900; margin: 0 0 6px; }
  .pk-intro { color: var(--text-secondary); margin: 0; line-height: 1.5; }
  .pk-empty { color: var(--text-secondary); font-size: 1rem; }

  /* Single column on mobile, two columns on desktop (≥768px). Centered column. */
  .container { max-width: 860px; }
  .pk-list { display: grid; grid-template-columns: 1fr; gap: 16px; max-width: 860px; margin-left: auto; margin-right: auto; align-items: start; }
  @media (min-width: 768px) { .pk-list { grid-template-columns: 1fr 1fr; } }

  .pk-card {
    background: #fff; border: 1px solid #e5e5e5; border-radius: 12px; overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,.04);
  }

  /* Header — always visible, click/tap toggles expansion. */
  .pk-card__head {
    width: 100%; display: flex; align-items: center; gap: 14px; text-align: left;
    background: none; border: none; cursor: pointer; padding: 14px; font: inherit; color: inherit;
  }
  .pk-card__thumb {
    flex: 0 0 64px; width: 64px; height: 64px; border-radius: 8px; overflow: hidden;
    background: #f0f0f0; display: flex; align-items: center; justify-content: center; font-size: 1.4rem;
  }
  .pk-card__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; aspect-ratio: 1 / 1; }
  .pk-card__headtext { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; }

  /* #999 on white is 2.85:1 — this is 11.5px text, so WCAG AA wants 4.5:1.
     #6B6B6B gives 5.33:1 and still reads as clearly secondary. */
  .pk-card__meta {
    display: flex; align-items: center; gap: 8px;
    font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; color: #6B6B6B;
  }
  /* Purely a separator between date and author, so it is aria-hidden rather
     than contrast-corrected — darkening it would make the divider compete with
     the text it separates. */
  .pk-card__dot { color: #ccc; }
  .pk-card__title { font-family: var(--font-headline); font-size: 1.05rem; font-weight: 800; line-height: 1.25; color: #111; }

  /* First-sentence preview — collapsed only, hidden once expanded. */
  .pk-card__preview {
    display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    font-size: .88rem; color: #555; line-height: 1.45; margin-top: 2px;
  }
  .pk-card[data-expanded="true"] .pk-card__preview { display: none; }

  .pk-card__chev { flex: 0 0 auto; color: #bbb; font-size: 1rem; transition: transform .2s ease; }
  .pk-card[data-expanded="true"] .pk-card__chev { transform: rotate(180deg); color: var(--brand-primary, #ff9900); }

  /* Collapsible body — fully hidden when collapsed (max-height:0 + overflow),
     so only the first-sentence preview shows; smooth animation when expanded. */
  .pk-card__panel { overflow: hidden; max-height: 0; transition: max-height .3s ease; }
  .pk-card[data-expanded="true"] .pk-card__panel { max-height: 600px; }
  .pk-card__text {
    padding: 4px 14px 16px;
    color: var(--text-primary, #222); line-height: 1.55; font-size: .96rem;
  }
  .pk-card__text :global(p) { margin: 0 0 .5em; }
  .pk-card__text :global(p:last-child) { margin-bottom: 0; }
</style>
