---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

const lang = 'fi';
const fmt = (d: Date) =>
  d.toLocaleDateString('fi-FI', { day: 'numeric', month: 'numeric', year: 'numeric' });

// FI-only collection. Show only published (draft: false), newest first, latest
// 10. Older pikauutiset stay in the collection (archived in git) but aren't
// listed here.
const published = (await getCollection('pikauutiset', (e) => !e.data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latest = published.slice(0, 10);

// Body (2–3 sentences) is the markdown content area — render each entry.
const items = await Promise.all(
  latest.map(async (e) => {
    const { Content } = await render(e);
    return { data: e.data, Content };
  })
);
---
<BaseLayout
  title="Pikauutiset"
  lang={lang}
  description="Lyhyet uutissalamat moottoriurheilun maailmasta — MXGP, speedway, enduro, historia ja tekniikka."
>
  <section class="pk">
    <div class="container">
      <div class="pk-head">
        <h1 class="pk-title">Pikauutiset</h1>
        <p class="pk-intro">Lyhyet uutissalamat moottoriurheilun maailmasta.</p>
      </div>

      {items.length === 0 ? (
        <p class="pk-empty">Ei vielä pikauutisia. Palaa pian uudelleen!</p>
      ) : (
        <div class="pk-list">
          {items.map((item) => (
            <article class="pk-card">
              {item.data.photo && (
                <div class="pk-card__media">
                  <img src={item.data.photo} alt={item.data.title} loading="lazy" />
                </div>
              )}
              <div class="pk-card__body">
                <div class="pk-card__meta">
                  <time datetime={item.data.date.toISOString().slice(0, 10)}>{fmt(item.data.date)}</time>
                  <span class="pk-card__dot">·</span>
                  <span class="pk-card__author">{item.data.author}</span>
                </div>
                <h2 class="pk-card__title">{item.data.title}</h2>
                <div class="pk-card__text">
                  <item.Content />
                </div>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .pk { padding: var(--space-5, 3rem) 0; }
  .pk-head { margin-bottom: 28px; }
  .pk-title { font-family: var(--font-headline); font-size: 2rem; font-weight: 900; margin: 0 0 6px; }
  .pk-intro { color: var(--text-secondary); margin: 0; line-height: 1.5; }
  .pk-empty { color: var(--text-secondary); font-size: 1rem; }

  .pk-list { display: flex; flex-direction: column; gap: 18px; max-width: 760px; }

  .pk-card {
    display: flex; gap: 18px;
    background: #fff; border: 1px solid #e5e5e5; border-radius: 12px; overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,.04);
  }
  .pk-card__media { flex: 0 0 180px; }
  .pk-card__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .pk-card__body { flex: 1; min-width: 0; padding: 18px 20px; }

  .pk-card__meta {
    display: flex; align-items: center; gap: 8px;
    font-size: .78rem; font-weight: 700; text-transform: uppercase; letter-spacing: .5px;
    color: #999; margin-bottom: 6px;
  }
  .pk-card__dot { color: #ccc; }

  .pk-card__title { font-family: var(--font-headline); font-size: 1.2rem; font-weight: 800; margin: 0 0 8px; line-height: 1.25; }
  .pk-card__text { color: var(--text-primary, #222); line-height: 1.55; font-size: .96rem; }
  .pk-card__text :global(p) { margin: 0 0 .5em; }
  .pk-card__text :global(p:last-child) { margin-bottom: 0; }

  @media (max-width: 560px) {
    .pk-card { flex-direction: column; gap: 0; }
    .pk-card__media { flex: none; aspect-ratio: 16 / 9; }
  }
</style>
