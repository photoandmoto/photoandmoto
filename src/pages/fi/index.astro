---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import LatestSidebar from '../../components/LatestSidebar.astro';
import UpcomingRaces from '../../components/UpcomingRaces.astro';
import RotatingHeroSplit from '../../components/RotatingHeroSplit.astro';
import MysteryHelpBlock from '../../components/MysteryHelpBlock.astro';
import { getCollection } from 'astro:content';
import { ui } from '../../i18n/ui';

const fmt = (d: Date) =>
  d.toLocaleDateString('fi-FI', { day: 'numeric', month: 'numeric', year: 'numeric' });

const lang = 'fi';
const t = ui[lang];

const articles = (await getCollection('articles', (entry) =>
  entry.id.startsWith('fi/') && !entry.data.draft
)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const slugFor = (a: any) => `/fi/aikakone/${a.id.replace(/^fi\//, '')}`;
const imgFor = (a: any) => a.data.card_image || a.data.featured_image;
const focusFor = (a: any) => a.data.card_image ? a.data.card_image_focus : a.data.featured_image_focus;

// Featured hero + sidebar: 1 hero article + 5 sidebar articles (1 lead + 4 compact rows)
const featuredArticle = articles[0];
const sidebarArticles = articles.slice(1, 6);
const sidebarItems = sidebarArticles.map(a => ({
  href: slugFor(a),
  image: imgFor(a),
  title: a.data.title,
  subtitle: fmt(a.data.date),
  category: a.data.category,
  focus: focusFor(a),
}));

const galleries = await getCollection('galleries');
const featuredGalleries = galleries.slice(0, 4);

// Scramble 2026 entry-stats promo. Hides itself the day after the event rather
// than needing to be remembered and removed. The counts come from the same
// daily-refreshed file the /fi/scramble-2026 page reads.
import scrambleData from '../../../public/data/scramble-2026.json';
const scrambleSnap = scrambleData?.snapshots?.[scrambleData.snapshots.length - 1] ?? null;
const showScramble = scrambleSnap && new Date() <= new Date('2026-08-30T23:59:59+03:00');

// Podcast episodes — using archive photos as cover images
const podcastEpisodes = [
  {
    title: 'Heikki Mikkola: Nelinkertainen Motocrossin Maailmanmestari',
    subtitle: 'Tarina legendaarisesta suomalaiskuljettajasta',
    href: '/fi/podcast#ep-0',
    image: '/galleries/hyvinkaa-scramble/display/Heikki Mikkola ja Jaroslav Falta_display.jpg',
  },
  {
    title: 'Honda CR250: Legendan Synty ja Loppu',
    subtitle: 'Motocrossin ikonisimman pyörän tarina',
    href: '/fi/podcast#ep-1',
    image: '/galleries/suomi-70s/display/Arto Vilkman ja Honda CR 250 1979_display.jpg',
  },
  {
    title: 'Suzuki Motocross Racing: From Disastrous Start to Golden Era',
    subtitle: 'Suzukin tie motocrossin kultaiselle aikakaudelle',
    href: '/fi/podcast#ep-2',
    image: '/galleries/international-70s/display/Hyvinkää GP-250 1971 Joel Robertin, Sylvain Geboersin ja Olle Petterssonin Suzukit_display.jpg',
  },
  {
    title: 'Motocross of Nations: Historia ja Voittajat',
    subtitle: 'Motocross of Nations -kilpailun legendat',
    href: '/fi/podcast#ep-3',
    image: '/galleries/international-70s/display/R. De Coster, H.Everts ja A. Malherbe. Motocross Des Nations 500 Ruskeasanta 1979_display.jpg',
  },
];

// Build items array for galleries using the existing structure
// Subtitle is the gallery blurb, not the photo count: a count repeats what the
// card already implies, while a sentence gives a reason to click. The count is
// still shown on /fi/galleria. Falls back to the count if a blurb is missing.
const galleryItems = featuredGalleries.map(g => ({
  href: `/fi/galleria/${g.data.slug}`,
  image: `/galleries/${g.data.slug}/${g.data.cover_image}`,
  title: g.data.title,
  subtitle: g.data.description || t['gallery.photoCount'].replace('{count}', g.data.images.length.toString()),
}));
---

<BaseLayout
  title="Etusivu"
  lang={lang}
  description="Motocrossin ja moottoripyöräurheilun kuvia, tarinoita ja tuloksia 1960-luvulta nykypäivään. MXGP 2026, Aikakone-arkisto ja valokuvagalleria."
>
  <h1 class="sr-only">Photo & Moto — Vauhtia ja elämää linssin läpi</h1>

  {/* ===== Featured hero + sidebar (articles) ===== */}
  {featuredArticle && (
    <section class="section featured-grid-section">
      <div class="container">
        <div class="section-header-row">
          <h2 class="section-heading">Uusimmat artikkelit</h2>
          <a href="/fi/aikakone" class="section-all-link">Kaikki artikkelit →</a>
        </div>
        <p class="section-subheading">Lue tuoreimmat motocross-uutiset, kilpailuraportit, historiatarinat ja kuljettajahaastattelut.</p>
        <div class="featured-row">
          <ArticleCard
            href={slugFor(featuredArticle)}
            image={imgFor(featuredArticle)}
            category={featuredArticle.data.category}
            title={featuredArticle.data.title}
            subtitle={featuredArticle.data.subtitle}
            size="lg"
            textBelow
            focus={focusFor(featuredArticle)}
          />
          {sidebarItems.length > 0 && (
            <LatestSidebar items={sidebarItems} />
          )}
        </div>
      </div>
    </section>
  )}

  {/* ===== Upcoming races band ===== */}
  <UpcomingRaces />

  {/* ===== Scramble 2026 entry stats promo (auto-hides after the event) ===== */}
  {showScramble && (
    <section class="section scramble-promo">
      <div class="container">
        <a href="/fi/scramble-2026" class="sp-card" target="_blank" rel="noopener">
          <div class="sp-card__text">
            <span class="sp-card__eyebrow">Hyvinkää Scramble &amp; Trial näytösajo · 29.–30.8.2026</span>
            <h2 class="sp-card__title">Ilmoittautumistilanne</h2>
            <p class="sp-card__sub">
              {scrambleSnap.entries} ilmoittautumista · {scrambleSnap.uniqueRiders} kuljettajaa ·
              {' '}{scrambleSnap.classes.length} luokkaa
            </p>
          </div>
          <span class="sp-card__cta">Katso tilastot →</span>
        </a>
      </div>
    </section>
  )}

  {/* ===== Gallery section (rotating 1 big + 3 stacked) ===== */}
  {featuredGalleries.length > 0 && (
    <section class="section gallery-section">
      <div class="container">
        <div class="section-header-row">
          <h2 class="section-heading">Galleria</h2>
          <a href="/fi/galleria" class="section-all-link">Kaikki galleriat →</a>
        </div>
        <p class="section-subheading">Tutustu suomalaisen ja kansainvälisen motocrossin kuviin 1960-luvulta nykypäivään.</p>
        <RotatingHeroSplit items={galleryItems} variant="sidebar" />
      </div>
    </section>
  )}

  {/* ===== Podcast section (rotating 1 big + 3 stacked) ===== */}
  <section class="section podcast-section">
    <div class="container">
      <div class="section-header-row">
        <h2 class="section-heading">Podcast</h2>
        <a href="/fi/podcast" class="section-all-link">Kaikki jaksot →</a>
      </div>
      <p class="section-subheading">Kuuntele haastatteluja, tarinoita ja keskusteluja motocrossin legendojen kanssa.</p>
      <RotatingHeroSplit items={podcastEpisodes} variant="sidebar" />
    </div>
  </section>

  {/* ===== Mystery photo help block — appears only when unidentified photos exist ===== */}
  <MysteryHelpBlock lang="fi" />

  {/* ===== Ota yhteyttä CTA section ===== */}
  <section class="section cta-section">
    <div class="container">
      <h2 class="cta-section__heading">Ota yhteyttä</h2>
      <div class="cta-grid">
        <a href="/fi/yhteystiedot" class="cta-card">
          <svg class="cta-card__icon" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
            <circle cx="12" cy="13" r="4"></circle>
          </svg>
          <h3 class="cta-card__heading">Kuvien käyttö</h3>
          <p class="cta-card__body">Haluatko käyttää kuviamme? Käsittelemme pyynnöt tapauskohtaisesti.</p>
        </a>
        <a href="/fi/yhteystiedot" class="cta-card">
          <svg class="cta-card__icon" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
          <h3 class="cta-card__heading">Kysymykset</h3>
          <p class="cta-card__body">Mietityttääkö jokin? Meillä voi olla siihen vastaus.</p>
        </a>
        <a href="/fi/yhteystiedot" class="cta-card">
          <svg class="cta-card__icon" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
          </svg>
          <h3 class="cta-card__heading">Jutut</h3>
          <p class="cta-card__body">Jaa aiheeseen liittyvä juttusi artikkelinamme.</p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Section shared */
  .section-header-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-2);
    gap: var(--space-3);
  }

  .section-heading {
    font-family: var(--font-headline);
    font-size: 1.75rem;
    font-weight: 900;
    color: var(--text-primary);
    margin: 0;
  }

  .section-subheading {
    font-family: var(--font-headline);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--text-secondary);
    line-height: 1.3;
    margin: 0 0 var(--space-4);
  }

  .section-all-link {
    font-family: var(--font-headline);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    /* Darker amber than --brand-primary (#ff9900). The bright brand orange is
       ~2:1 on white/#F9F9F9 — fails WCAG AA for small text. #A85D00 gives
       ~4.8:1 while staying in the orange family. Scoped to this link only;
       --brand-primary is unchanged for fills/borders/large headings. */
    color: #A85D00;
    text-decoration: none;
    white-space: nowrap;
  }
  .section-all-link:hover {
    text-decoration: underline;
  }

  /* ===== Featured hero + sidebar layout ===== */
  .featured-row {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: var(--space-3);
    align-items: stretch;
  }

  .featured-row > article {
    min-height: 420px;
  }

  /* Articles section */
  .featured-grid-section {
    background: white;
    padding-top: var(--space-8);
    padding-bottom: var(--space-6);
  }

  /* UpcomingRaces defaults to white (correct for EN, where it still needs
     to contrast against EN's shaded Featured section). On FI, Featured is
     now white too, so Upcoming flips to shaded here to keep the
     alternating rhythm going; its cards flip to white in the same
     override so they don't disappear into the new shaded background.
     #upcomingRacesRoot gives this override enough specificity to reliably
     win over the component's own scoped rule, without touching the shared
     component or EN's page. */
  :global(#upcomingRacesRoot) {
    background: var(--bg-secondary);
  }
  :global(#upcomingRacesRoot .upcoming-card) {
    background: white;
  }

  /* Scramble 2026 promo — temporary, removed once the archive is frozen. */
  .scramble-promo { background: white; padding: var(--space-4) 0; }
  /* The event's lime, matching the stat tiles on /fi/scramble-2026. Every text
     colour on this card had to change with the background: the orange used
     before sits at 2.45:1 against this green and would have been unreadable.
     Navy is 6.97:1 and is the banner's own second colour. */
  .sp-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    background: #A8C209;
    border: 1px solid rgba(0,0,0,0.10);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    text-decoration: none;
    color: inherit;
    transition: filter 0.2s ease;
  }
  .sp-card:hover { filter: brightness(0.96); }
  .sp-card__eyebrow {
    display: block;
    font-family: var(--font-headline);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: #042C53;
    margin-bottom: 2px;
  }
  .sp-card__title {
    font-family: var(--font-headline);
    font-size: 1.35rem;
    font-weight: 900;
    margin: 0 0 2px;
    color: #042C53;
  }
  .sp-card__sub { margin: 0; color: #0C447C; font-size: 0.95rem; }
  .sp-card__cta {
    font-family: var(--font-headline);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #042C53;
    white-space: nowrap;
  }

  /* Gallery section */
  .gallery-section {
    background: white;
    padding: var(--space-6) 0;
  }

  /* Swap hero/stack sides: stacked 3 on the left, big card on the right.
     Scoped to .gallery-section and desktop only, so the Podcast section
     (which shares the same RotatingHeroSplit "sidebar" variant) and the
     mobile single-column layout are both left untouched. */
  @media (min-width: 901px) {
    .gallery-section :global(.rhs--sidebar) {
      grid-template-columns: 1fr 2fr;
    }
    .gallery-section :global(.rhs__big) {
      order: 2;
    }
    .gallery-section :global(.rhs__stack) {
      order: 1;
    }
  }

  /* Podcast section */
  .podcast-section {
    background: var(--bg-secondary);
    padding: var(--space-6) 0;
  }

  /* MysteryHelpBlock's own .mhb rule is white, which is now correct here
     too — Podcast (just above it) is shaded, so no override is needed;
     removing the FI override that used to shade it keeps the alternation
     going: Upcoming(shaded) -> Gallery(white) -> Podcast(shaded) ->
     MysteryHelpBlock(white) -> CTA(shaded). */

  /* ===== CTA section ("Ota yhteyttä") ===== */
  .section.cta-section {
    background: var(--bg-secondary);
    padding: var(--space-4) 0;
  }

  .cta-section__heading {
    font-family: var(--font-headline);
    font-size: 1.75rem;
    font-weight: 900;
    color: var(--text-primary);
    margin: 0 0 var(--space-4);
  }

  .cta-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }

  .cta-card {
    display: block;
    background: #0e0e0e;
    border-radius: var(--radius-md);
    padding: var(--space-4);
    text-decoration: none;
    transition: transform 0.2s ease, background 0.2s ease;
    border: 1px solid rgba(255, 153, 0, 0.15);
  }

  .cta-card:hover {
    transform: translateY(-2px);
    background: #1a1a1a;
    border-color: rgba(255, 153, 0, 0.4);
  }

  .cta-card__icon {
    display: block;
    color: var(--brand-primary);
    margin: 0 0 var(--space-2);
  }

  .cta-card__heading {
    font-family: var(--font-headline);
    font-size: 1.2rem;
    font-weight: 900;
    color: var(--brand-primary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin: 0 0 var(--space-2);
    line-height: 1.2;
  }

  .cta-card__body {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.5;
    margin: 0;
  }

  /* Responsive breakpoints */
  @media (max-width: 900px) {
    .featured-row {
      grid-template-columns: 1fr;
    }
    .featured-row > article {
      min-height: 320px;
    }
    .cta-grid {
      grid-template-columns: 1fr;
    }
    .cta-section {
      padding: var(--space-8) 0;
    }
  }

  @media (max-width: 540px) {
    .section-heading {
      font-size: 1.4rem;
    }
  }
</style>
