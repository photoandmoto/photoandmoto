---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import heroImage from '../../../assets/site/hero-aikakone.jpg';
import { getCollection } from 'astro:content';
import { ui } from '../../../i18n/ui';
import { buildArticleSearchText } from '../../../lib/articleSearch';

const lang = 'fi';
const t = ui[lang];

const articles = (await getCollection('articles', (entry) =>
  entry.id.startsWith('fi/') && !entry.data.draft
)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout
  title="Aikakone"
  lang={lang}
  description="Motocrossin ja moottoriurheilun historia-artikkelit: suomalaiset tähdet, legendaariset kilpailut ja vuosikymmenten tarinoita radalta."
>
  <section class="section">
    <div class="container">
      <PageHero
        image={heroImage}
        title="Aikakone"
        subtitle="Matka moottoriurheilun historian havinaan"
      />

      <p class="aikakone-intro">Aikakone moottoriurheilun ytimessä. Lue lyhyitä paloja lajin historiasta ja tulevaisuuden murroksista juuri sellaisina kuin ne ovat.</p>

      {articles.length > 0 && (
        <div class="article-filter">
          <label class="article-filter__label" for="articleSearch">Etsi artikkeleista</label>
          <input
            type="search"
            id="articleSearch"
            class="article-filter__input"
            placeholder="Esim. Kawasaki, MXGP, Carlqvist…"
            autocomplete="off"
          />
          <p class="article-filter__count" id="articleCount" role="status" aria-live="polite"></p>
          <p class="article-filter__hint">
            Haku kohdistuu otsikoihin ja aiheisiin. Etsitkö sanaa artikkelin
            sisältä? <a href="/fi/etsi">Etsi koko sivustolta</a>.
          </p>
        </div>
      )}

      {articles.length > 0 ? (
        <Fragment>
        <div class="articles-grid">
          {articles.map(article => {
            const formattedDate = new Intl.DateTimeFormat('fi-FI', {
              year: 'numeric',
              month: 'short',
              day: 'numeric'
            }).format(article.data.date);

            // Keyword blob for the client-side filter: metadata verbatim,
            // plus the article body distilled to unique words. See
            // src/lib/articleSearch.ts for why the body is deduplicated.
            const searchText = buildArticleSearchText(article);

            return (
              <article class="article-card" data-search={searchText}>
                <a href={`/fi/aikakone/${article.id.replace(/^fi\//, '')}`}>
                  <div class="article-card__image-wrap">
                    <img
                      src={article.data.card_image || article.data.featured_image}
                      alt={article.data.title}
                      class="article-card__image"
                      loading="lazy"
                    />
                  </div>
                  <div class="article-card__content">
                    <div class="article-card__meta">
                      <span class="badge badge--small">{article.data.category}</span>
                      <span class="article-card__date">{formattedDate}</span>
                    </div>
                    <h2 class="article-card__title">{article.data.title}</h2>
                    {article.data.subtitle && (
                      <p class="article-card__text">{article.data.subtitle}</p>
                    )}
                  </div>
                </a>
              </article>
            );
          })}
        </div>

        <div class="article-more">
          <p class="article-empty" id="articleEmpty" hidden>
            Ei osumia hakusanalla. Kokeile toista sanaa tai
            <a href="/fi/etsi">etsi koko sivustolta</a>.
          </p>
          <button type="button" id="articleMore" class="article-more__btn" hidden>
            Näytä lisää
          </button>
        </div>
        </Fragment>
      ) : (
        <div class="empty-state">
          <p>Ei vielä artikkeleita. Palaa pian!</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  // Client-side keyword filter + progressive reveal for the article grid.
  //
  // Design notes:
  //  - Every article card is rendered at build time and stays in the DOM.
  //    We only toggle a CSS class. That means (a) the filter always searches
  //    the full set, not just what's visible, and (b) Google still sees every
  //    article link on the page.
  //  - Match data lives in each card's data-search attribute, pre-lowercased
  //    at build time (see the .astro frontmatter above).
  //  - Multi-word queries are AND-ed: "kawasaki 1979" matches a card only if
  //    both terms appear somewhere in its metadata.

  const PAGE_SIZE = 12;

  const grid = document.querySelector('.articles-grid');
  const input = document.getElementById('articleSearch');
  const moreBtn = document.getElementById('articleMore');
  const countEl = document.getElementById('articleCount');
  const emptyEl = document.getElementById('articleEmpty');

  if (grid && input && moreBtn && countEl && emptyEl) {
    const cards = Array.from(grid.querySelectorAll('.article-card'));
    let visibleLimit = PAGE_SIZE;

    function currentMatches() {
      const q = input.value.trim().toLowerCase();
      if (!q) return cards;
      const terms = q.split(/\s+/);
      return cards.filter((card) => {
        const haystack = card.dataset.search || '';
        return terms.every((term) => haystack.includes(term));
      });
    }

    function render() {
      const matches = currentMatches();
      const shown = matches.slice(0, visibleLimit);
      const shownSet = new Set(shown);

      cards.forEach((card) => {
        card.classList.toggle('is-hidden', !shownSet.has(card));
      });

      // Result count: only meaningful once the user has typed something.
      const q = input.value.trim();
      if (q) {
        countEl.textContent =
          matches.length === 1
            ? '1 osuma'
            : `${matches.length} osumaa`;
      } else {
        countEl.textContent = '';
      }

      emptyEl.hidden = matches.length > 0;

      // Button label is static in the HTML — we only toggle visibility.
      const remaining = matches.length - shown.length;
      moreBtn.hidden = remaining <= 0;
    }

    input.addEventListener('input', () => {
      // A new query resets the reveal window — otherwise a user who had
      // clicked "show more" would see an inconsistent number of results
      // between searches.
      visibleLimit = PAGE_SIZE;
      render();
    });

    moreBtn.addEventListener('click', () => {
      visibleLimit += PAGE_SIZE;
      render();
    });

    render();
  }
</script>

<style>
  .article-filter {
    max-width: 520px;
    margin: 0 auto var(--space-5);
    text-align: center;
  }

  .article-filter__label {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-secondary);
    margin-bottom: var(--space-1);
  }

  .article-filter__input {
    width: 100%;
    padding: 12px 16px;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--text-primary);
    background: white;
    border: 2px solid #ddd;
    border-radius: 8px;
    transition: border-color var(--transition-base);
  }

  .article-filter__input:focus {
    outline: none;
    border-color: var(--brand-primary);
  }

  .article-filter__count {
    min-height: 1.2em;
    margin-top: var(--space-1);
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .article-filter__hint {
    margin-top: var(--space-1);
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  .article-filter__hint a {
    color: var(--brand-primary);
    font-weight: 600;
  }

  /* The filter and the reveal window both work by toggling this class.
     Cards are never removed from the DOM — see the script for why. */
  .article-card.is-hidden {
    display: none;
  }

  .article-more {
    text-align: center;
    margin-top: var(--space-5);
  }

  .article-more__btn {
    padding: 12px 28px;
    background: var(--brand-primary);
    color: #000;
    border: none;
    border-radius: 6px;
    font-family: var(--font-headline);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    cursor: pointer;
    transition: background var(--transition-base);
  }

  .article-more__btn:hover {
    background: #cc7a00;
  }

  .article-empty {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .article-empty a {
    color: var(--brand-primary);
    font-weight: 600;
  }

  .aikakone-intro {
    max-width: 100%;
    margin: 0 auto var(--space-6);
    text-align: center;
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--text-primary);
    font-weight: 600;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
  }

  .article-card {
    background: white;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .article-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .article-card a {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .article-card__image-wrap {
    overflow: hidden;
    aspect-ratio: 16 / 10;
  }

  .article-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-base);
  }

  .article-card:hover .article-card__image {
    transform: scale(1.05);
  }

  .article-card__content {
    padding: var(--space-2);
  }

  .article-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin-bottom: var(--space-1);
  }

  .badge--small {
    font-size: 0.65rem;
    padding: 2px 8px;
  }

  .article-card__date {
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .article-card__title {
    font-size: 0.95rem;
    color: var(--brand-secondary);
    margin-bottom: var(--space-1);
    line-height: 1.3;
  }

  .article-card__text {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .empty-state {
    text-align: center;
    padding: var(--space-8) 0;
    color: var(--text-secondary);
  }

  @media (max-width: 1024px) {
    .articles-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .articles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

