---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import heroImage from '../../../assets/site/hero-galleria.jpg';
import { getCollection } from 'astro:content';
import { ui } from '../../../i18n/ui';

const lang = 'fi';
const t = ui[lang];

const _galleries = await getCollection('galleries');

// Explicit display order for the gallery grid. Galleries are listed by slug in
// the intended reading order; any gallery not in this list falls to the end
// (alphabetically) so new galleries still appear without a code change.
// Note: suomi-20s (the 2020s) sorts AFTER suomi-90s, since the 2020s follow the
// 1990s chronologically even though "20" sorts before "70/80/90" as a string.
const GALLERY_ORDER = [
  'hyvinkaa-scramble',
  'international-70s',
  'international-80s',
  'international-90s',
  'suomi-70s',
  'suomi-80s',
  'suomi-90s',
  'suomi-20s',
];
const galleries = [..._galleries].sort((a, b) => {
  const ia = GALLERY_ORDER.indexOf(a.data.slug);
  const ib = GALLERY_ORDER.indexOf(b.data.slug);
  if (ia === -1 && ib === -1) return a.data.slug.localeCompare(b.data.slug);
  if (ia === -1) return 1;
  if (ib === -1) return -1;
  return ia - ib;
});
---

<BaseLayout 
  title="Galleria" 
  lang={lang}
  description="Motocrossin valokuvagalleria: kansainväliset ja kotimaiset kuvat 1970-, 1980- ja 1990-luvuilta. Suomi- ja MM-kuvia arkistosta."
>
  <section class="section">
    <div class="container">
      <PageHero
        image={heroImage}
        title="Galleria"
        subtitle="Tutustu kuvagallerioihin eri lajien ja aikakausien parista"
      />
      
      <p class="gallery-intro">Astu maailmaan missä jokainen kuva kertoo tarinan. Maailma, jossa jokainen kuva sykkii tarinaa ja moottoriurheilun huumaava menneisyys ja jännitys heräävät eloon, on vain klikkauksen päässä sinusta.</p>
      
      <div class="photo-search">
        <div class="photo-search-input-wrap">
          <input type="text" id="photoSearch" class="photo-search-input" placeholder="Hae kuvia... esim. Mikkola, Ruskeasanta, 1978" />
          <button id="photoClear" class="photo-search-clear" style="display:none;">&#10005;</button>
        </div>
        <div id="photoCount" class="photo-search-count"></div>
      </div>
      
      <div id="photoResults" class="photo-results" style="display:none;"></div>
      
      <div id="galleryCards" class="grid grid--3">
        {galleries.map(gallery => (
          <article class="card">
            <a href={`/fi/galleria/${gallery.data.slug}`}>
              <img 
                src={`/galleries/${gallery.data.slug}/${gallery.data.cover_image}`}
                alt={gallery.data.title}
                class="card__image"
                loading="lazy"
              />
              <div class="card__content">
                <h2 class="card__title">{gallery.data.title}</h2>
                <p class="card__text">{gallery.data.description}</p>
                <p class="gallery-count">
                  {t['gallery.photoCount'].replace('{count}', gallery.data.images.length.toString())}
                </p>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/photoswipe@5.4.3/dist/photoswipe.css">

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import PhotoSwipe from 'photoswipe';

  const input = document.getElementById('photoSearch');
  const clearBtn = document.getElementById('photoClear');
  const resultsDiv = document.getElementById('photoResults');
  const countDiv = document.getElementById('photoCount');
  const galleryCards = document.getElementById('galleryCards');

  let INDEX = null;        // loaded lazily on first search
  let loading = false;
  let currentMatches = [];  // matches backing the current lightbox

  // In-place lightbox opened from an explicit array of matches.
  const lightbox = new PhotoSwipeLightbox({
    pswpModule: PhotoSwipe,
    bgOpacity: 0.95,
    loop: true,
    zoom: true,
    padding: { top: 20, bottom: 60, left: 20, right: 20 },
  });
  lightbox.on('uiRegister', function () {
    lightbox.pswp.ui.registerElement({
      name: 'search-caption',
      order: 9,
      isButton: false,
      appendTo: 'root',
      onInit: (el, pswp) => {
        el.style.cssText = 'position:absolute;bottom:10px;left:50%;transform:translateX(-50%);background:rgba(0,0,0,0.8);color:white;padding:8px 20px;border-radius:8px;font-size:14px;max-width:80%;text-align:center;pointer-events:none;';
        pswp.on('change', () => {
          const cap = pswp.currSlide?.data?.alt || '';
          el.innerHTML = cap;
          el.style.display = cap ? 'block' : 'none';
        });
      },
    });
  });
  lightbox.init();

  async function ensureIndex() {
    if (INDEX || loading) return;
    loading = true;
    try {
      const r = await fetch('/data/gallery-search.json');
      INDEX = await r.json();
    } catch {
      INDEX = [];
    }
    loading = false;
  }

  function render(matches) {
    galleryCards.style.display = 'none';
    resultsDiv.style.display = 'grid';
    countDiv.textContent = matches.length + ' kuvaa löytyi' + (matches.length === 0 ? ' — kokeile toista hakusanaa' : '');
    if (matches.length === 0) { resultsDiv.innerHTML = ''; return; }

    resultsDiv.innerHTML = matches.slice(0, 60).map((img, i) =>
      '<a href="' + img.display + '" class="photo-result" data-i="' + i + '">' +
        '<img src="' + img.thumb + '" alt="' + img.caption + '" loading="lazy" />' +
        '<div class="photo-result-info">' +
          '<span class="photo-result-caption">' + img.caption + '</span>' +
          '<span class="photo-result-gallery">' + img.gallery + '</span>' +
        '</div>' +
      '</a>'
    ).join('');
    if (matches.length > 60) {
      resultsDiv.innerHTML += '<div class="photo-result-more">+ ' + (matches.length - 60) + ' lisää tulosta</div>';
    }
  }

  async function runSearch() {
    const q = input.value.trim().toLowerCase();
    if (q.length < 2) {
      resultsDiv.style.display = 'none';
      galleryCards.style.display = '';
      countDiv.textContent = '';
      clearBtn.style.display = 'none';
      return;
    }
    clearBtn.style.display = 'block';
    await ensureIndex();
    currentMatches = (INDEX || []).filter(img =>
      img.caption.toLowerCase().includes(q) || img.gallery.toLowerCase().includes(q)
    );
    render(currentMatches);
  }

  input.addEventListener('input', runSearch);

  // Open the clicked result in-place; arrows cycle only the matches (first 60 shown).
  resultsDiv.addEventListener('click', (e) => {
    const link = e.target.closest('a.photo-result');
    if (!link) return;
    e.preventDefault();
    const shown = currentMatches.slice(0, 60);
    const startIndex = parseInt(link.getAttribute('data-i'), 10) || 0;
    const dataSource = shown.map(img => ({
      src: img.display,
      width: img.width || undefined,
      height: img.height || undefined,
      alt: img.caption || '',
    }));
    lightbox.loadAndOpen(startIndex, dataSource);
  });

  clearBtn.addEventListener('click', () => {
    input.value = '';
    resultsDiv.style.display = 'none';
    galleryCards.style.display = '';
    countDiv.textContent = '';
    clearBtn.style.display = 'none';
  });
</script>

<style is:global>
  .gallery-intro {
    max-width: 100%;
    margin: 0 auto var(--space-4);
    text-align: center;
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--text-primary);
    font-weight: 600;
  }

  .gallery-count {
    font-size: 0.875rem;
    color: var(--brand-primary);
    font-weight: 600;
    margin-top: var(--space-1);
  }
  
  .photo-search {
    margin-bottom: var(--space-5);
  }
  
  .photo-search-input-wrap {
    position: relative;
    max-width: 600px;
    margin: 0 auto;
  }
  
  .photo-search-input {
    width: 100%;
    padding: 14px 48px 14px 18px;
    font-family: var(--font-body);
    font-size: 1rem;
    border: 2px solid #ddd;
    border-radius: var(--radius-md);
    background: #fff;
    transition: border-color 0.15s;
  }
  
  .photo-search-input:focus {
    outline: none;
    border-color: #ff9900;
  }
  
  .photo-search-clear {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    font-size: 1.2rem;
    color: #888;
    cursor: pointer;
    padding: 4px;
  }
  
  .photo-search-clear:hover {
    color: #ff9900;
  }
  
  .photo-search-count {
    text-align: center;
    margin-top: var(--space-2);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-secondary);
  }
  
  .photo-results {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 10px;
    margin-bottom: var(--space-6);
  }
  
  .photo-result {
    display: block;
    text-decoration: none;
    background: #F9F9F9;
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: transform 0.15s, box-shadow 0.15s;
  }
  
  .photo-result:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 16px rgba(0,0,0,0.12);
  }
  
  .photo-result img {
    width: 100%;
    height: 140px;
    object-fit: cover;
    display: block;
  }
  
  .photo-result-info {
    padding: 8px 10px;
  }
  
  .photo-result-caption {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    color: #1D1D1F;
    line-height: 1.3;
    margin-bottom: 2px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  
  .photo-result-gallery {
    display: block;
    font-size: 0.65rem;
    color: #ff9900;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  
  .photo-result-more {
    grid-column: 1 / -1;
    text-align: center;
    padding: var(--space-3);
    color: var(--text-secondary);
    font-weight: 600;
    font-size: 0.9rem;
  }
  
  @media (max-width: 768px) {
    .photo-results {
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    }
    
    .photo-result img {
      height: 110px;
    }
  }
</style>