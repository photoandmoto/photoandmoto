  document.querySelectorAll('textarea.inp').forEach(ta => ta.dispatchEvent(new Event('input')));
  $('fla-title-count').textContent='0 / 80'; $('fla-body-count').textContent='0 / 500';
  $('fla-consent-photo-wrap').classList.add('consent-wrap-hidden');
  $('fla-consent-photo').checked=false; $('fla-consent-content').checked=false;
  $('flash-submit-msg').style.display='none';
  flaConsentUpdate();
  document.querySelector('.app-main').scrollTo(0,0);
}

$('app-flash-form').addEventListener('submit', async e=>{
  e.preventDefault();
  const msg=$('flash-gen-msg'); const btn=$('fla-gen-btn');
  msg.style.display='none';
  btn.disabled=true; btn.classList.add('btn-loading'); const orig=btn.textContent; btn.textContent='Luodaan…';
  try {
    const fd=new FormData(e.target);
    fd.delete('photo');
    const fp=$('fla-ph-cam')?.files?.[0]||$('fla-ph-file')?.files?.[0];
    if(fp) fd.set('photo',fp,fp.name);
    pendingFlash={category:fd.get('category')||'',date:fd.get('paivays')||'',photo:fp&&fp.size>0?fp:null};
    const r=await fetch('/api/generate-article',{method:'POST',credentials:'same-origin',body:fd});
    const data=await r.json().catch(()=>({}));
    if(r.ok&&data.ok){
      $('fla-edit-title').value=data.title||'';
      $('fla-edit-body').value=data.body||'';
      $('fla-edit-body').dispatchEvent(new Event('input'));
      flashCharCount();
      $('fla-consent-photo-wrap').classList.toggle('consent-wrap-hidden',!pendingFlash?.photo);
      $('flash-form-screen').style.display='none';
      $('flash-review-screen').classList.remove('flash-review-hidden');
      flaConsentUpdate();
      document.querySelector('.app-main').scrollTo(0,0);
    } else if(r.status===401||r.status===403){
      msg.textContent='✗ Istunto vanhentunut — kirjaudu uudelleen.'; msg.className='msg err'; msg.style.display='block';
    } else {
      msg.textContent='✗ '+(data.error||'Pikauutisen luonti epäonnistui — yritä uudelleen.'); msg.className='msg err'; msg.style.display='block';
    }
  } catch {
    msg.textContent='✗ Yhteysvirhe — yritä uudelleen.'; msg.className='msg err'; msg.style.display='block';
  } finally { btn.disabled=false; btn.classList.remove('btn-loading'); btn.textContent=orig; }
});

$('fla-submit-btn').addEventListener('click', async()=>{
  const msg=$('flash-submit-msg'); const btn=$('fla-submit-btn');
  msg.style.display='none';
  const photoRequired=!$('fla-consent-photo-wrap').classList.contains('consent-wrap-hidden');
  if((photoRequired&&!$('fla-consent-photo').checked)||!$('fla-consent-content').checked){
    msg.textContent='Vahvista suostumus ennen lähettämistä rastittamalla vaaditut ruudut.'; msg.className='msg err'; msg.style.display='block'; return;
  }
  const title=($('fla-edit-title')?.value||'').trim();
  const body=($('fla-edit-body')?.value||'').trim();
  if(!title){msg.textContent='✗ Otsikko ei voi olla tyhjä.';msg.className='msg err';msg.style.display='block';return;}
  if(!body){msg.textContent='✗ Teksti ei voi olla tyhjä.';msg.className='msg err';msg.style.display='block';return;}
  btn.disabled=true; btn.classList.add('btn-loading'); const orig=btn.textContent; btn.textContent='Lähetetään…';
  try {
    const fd=new FormData();
    fd.append('title',title); fd.append('body',body);
    fd.append('category',pendingFlash?.category||''); fd.append('date',pendingFlash?.date||'');
    fd.append('consent_photo','1'); fd.append('consent_content','1');
    if(pendingFlash?.photo) fd.append('photo',pendingFlash.photo);
    const r=await fetch('/api/submit-pikauutinen',{method:'POST',credentials:'same-origin',body:fd});
    const data=await r.json().catch(()=>({}));
    if(r.ok&&data.ok){
      $('flash-review-screen').classList.add('flash-review-hidden');
      $('flash-confirm-screen').classList.remove('flash-review-hidden');
      document.querySelector('.app-main').scrollTo(0,0);
    } else if(r.status===401||r.status===403){
      msg.textContent='✗ Istunto vanhentunut — kirjaudu uudelleen.'; msg.className='msg err'; msg.style.display='block';
    } else {
      msg.textContent='✗ '+(data.error||'Lähetys epäonnistui — yritä uudelleen.'); msg.className='msg err'; msg.style.display='block';
    }
  } catch {
    msg.textContent='✗ Yhteysvirhe — yritä uudelleen.'; msg.className='msg err'; msg.style.display='block';
  } finally { btn.disabled=false; btn.classList.remove('btn-loading'); btn.textContent=orig; flaConsentUpdate(); }
});

$('fla-clear-btn').addEventListener('click', resetFlash);
$('fla-new-btn').addEventListener('click', resetFlash);
$('fla-again-btn').addEventListener('click', resetFlash);

// ── Photo form ──
function phoFileChanged() {
  const hasFile=!!($('pho-cam')?.files?.length||$('pho-file')?.files?.length);
  // Consent already gated — just re-evaluate button state
  phoConsentUpdate();
}
function phoConsentUpdate() {
  const hasFile=!!($('pho-cam')?.files?.length||$('pho-file')?.files?.length);
  const consented=$('pho-consent')?.checked;
  const btn=$('pho-submit-btn'); if(btn) btn.disabled=!(hasFile&&consented);
}
$('pho-consent').addEventListener('change', phoConsentUpdate);

$('pho-submit-wrap').addEventListener('click',()=>{
  if($('pho-submit-btn')?.disabled){
    const msg=$('pho-msg'); const hasFile=!!($('pho-cam')?.files?.length||$('pho-file')?.files?.length);
    if(!hasFile){ msg.textContent='Valitse ensin kuva.'; msg.className='msg err'; msg.style.display='block'; return; }
    msg.textContent='Vahvista suostumus ennen lähettämistä rastittamalla vaadittu ruutu.'; msg.className='msg err'; msg.style.display='block';
    $('pho-consent').closest('label')?.scrollIntoView({behavior:'smooth',block:'center'});
  }
});

$('app-photo-form').addEventListener('submit', async e=>{
  e.preventDefault();
  const msg=$('pho-msg'); const btn=$('pho-submit-btn');
  msg.style.display='none';
  const file=$('pho-cam')?.files?.[0]||$('pho-file')?.files?.[0];
  if(!file){msg.textContent='✗ Valitse kuva.';msg.className='msg err';msg.style.display='block';return;}
  if(!$('pho-consent').checked){msg.textContent='✗ Vahvista suostumus.';msg.className='msg err';msg.style.display='block';return;}
  btn.disabled=true; btn.classList.add('btn-loading'); const orig=btn.textContent; btn.textContent='Lähetetään…';
  try {
    const thumb=await generateThumb(file);
    const mainFile=await resizeMainImage(file);
    const fd=new FormData(e.target);
    fd.delete('photo'); fd.set('photo',mainFile);
    fd.set('consent_given','1');
    if(thumb) fd.append('thumb_data',thumb);
    const r=await fetch('/api/submit-photo',{method:'POST',credentials:'same-origin',body:fd});
    const data=await r.json().catch(()=>({}));
    if(r.ok&&data.ok){
      toast('✓ Kuva lähetetty toimitukselle!');
      e.target.reset(); $('pho-lbl').textContent='Ei tiedostoa valittu';
      phoConsentUpdate();
      document.querySelector('.app-main').scrollTo(0,0);
    } else if(r.status===401||r.status===403){
      msg.textContent='✗ Istunto vanhentunut — kirjaudu uudelleen.'; msg.className='msg err'; msg.style.display='block';
    } else {
      msg.textContent='✗ '+(data.error||'Lähetys epäonnistui — yritä uudelleen.'); msg.className='msg err'; msg.style.display='block';
    }
  } catch {
    msg.textContent='✗ Yhteysvirhe — yritä uudelleen.'; msg.className='msg err'; msg.style.display='block';
  } finally { btn.disabled=false; btn.classList.remove('btn-loading'); btn.textContent=orig; phoConsentUpdate(); }
});

$('pho-clear-btn').addEventListener('click',()=>{
  $('app-photo-form').reset();
  $('pho-lbl').textContent='Ei tiedostoa valittu';
  $('pho-msg').style.display='none';
  phoConsentUpdate();
});

// ── Idle auto-logout (25 min warn, 30 min logout) ──
(function(){
  const IDLE=30*60*1000, WARN=25*60*1000, THROTTLE=2000;
  let wt,lt,banner=null,last=0;
  function mkBanner(){
    if(banner) return banner;
    banner=document.createElement('div');
    banner.textContent='Istuntosi vanhenee 5 minuutissa. Jatka kirjautumista klikkaamalla.';
    Object.assign(banner.style,{
      position:'fixed',left:'50%',bottom:'80px',transform:'translateX(-50%)',
      zIndex:'9999',maxWidth:'min(92vw,420px)',background:'#1a1a1a',color:'#fff',
      border:'1px solid #ff9900',borderLeft:'4px solid #ff9900',borderRadius:'10px',
      padding:'14px 18px',font:'600 .88rem/1.4 system-ui,sans-serif',cursor:'pointer',
      boxShadow:'0 8px 24px rgba(0,0,0,.5)',display:'none',textAlign:'center',
    });
    banner.addEventListener('click',reset);
    document.body.appendChild(banner);
    return banner;
  }
  function showWarn(){mkBanner().style.display='block';}
  function hideWarn(){if(banner)banner.style.display='none';}
  async function doLogout(){
    hideWarn();
    try{await fetch('/api/auth/logout',{method:'POST',credentials:'same-origin'});}catch{}
    showScreen('screen-login');
  }
  function reset(){
    hideWarn(); clearTimeout(wt); clearTimeout(lt);
    wt=setTimeout(showWarn,WARN); lt=setTimeout(doLogout,IDLE);
  }
  function onActivity(){
    if(banner&&banner.style.display==='block'){last=Date.now();reset();return;}
    const now=Date.now(); if(now-last<THROTTLE)return; last=now; reset();
  }
  ['mousemove','keydown','click','touchstart'].forEach(ev=>document.addEventListener(ev,onActivity,{passive:true}));
  reset();
})();

// ── Voice input (Web Speech API) & Auto-expanding textareas ──
function initVoiceInputAndTextareas() {
  // 1. Textarea auto-expansion
  const textareas = document.querySelectorAll('textarea.inp');
  textareas.forEach(ta => {
    if (ta.dataset.autoExpandedBinded) return;
    ta.dataset.autoExpandedBinded = 'true';

    function adjustHeight() {
      ta.style.height = 'auto';
      ta.style.height = ta.scrollHeight + 'px';
    }
    ta.addEventListener('input', adjustHeight);
    // Initial adjustment
    adjustHeight();
  });

  // 2. Voice input setup
  const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
  if(!SR) return;
  let active=null; // {btn, rec} currently recording
  document.querySelectorAll('[data-mic]').forEach(input => {
    const wrap = input.closest('.input-wrap');
    if (!wrap) return;

    // 1. FORCE the wrapper to act as an anchor
    wrap.style.setProperty('position', 'relative', 'important');
    wrap.style.setProperty('display', 'block', 'important');

    if (wrap.querySelector('.mic-icon-btn')) return;

    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'mic-icon-btn';
    btn.setAttribute('aria-label', 'Sanele');

    // 2. BRUTE-FORCE inline styles to override ALL external CSS
    btn.style.cssText = `
      position: absolute !important;
      right: 8px !important;
      top: 50% !important;
      transform: translateY(-50%) !important;
      background: transparent !important;
      border: none !important;
      box-shadow: none !important;
      width: 44px !important;
      height: 44px !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      z-index: 9999 !important;
      color: #8E8E93 !important;
      padding: 0 !important;
      margin: 0 !important;
    `;

    btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v1a7 7 0 0 1-14 0v-1"/><line x1="12" x2="12" y1="19" y2="22"/></svg>`;

    wrap.appendChild(btn);

    btn.addEventListener('click',()=>{
      if(active){
        if(active.btn!==btn) return; // another field recording — ignore
        active.rec.stop(); return;   // same button — stop
      }
      const rec=new SR();
      rec.lang=input.dataset.mic||'fi-FI';
      rec.continuous=false; rec.interimResults=false;
      active={btn,rec};
      btn.classList.add('mic-active');
      rec.onresult=e=>{
        const t=e.results[0][0].transcript;
        input.value=input.value?input.value.trimEnd()+' '+t:t;
        input.dispatchEvent(new Event('input'));
      };
      rec.onerror=e=>{
        if(e.error==='not-allowed'){
          toast('Salli mikrofonin käyttöoikeus sanelua varten.');
        }else if(e.error==='no-speech'){
          toast('Puhetta ei havaittu. Yritä uudelleen.');
        }else if(e.error!=='aborted'){
          toast('Saneluvirhe — yritä uudelleen.');
        }
      };
      rec.onend=()=>{
        active=null;
        btn.classList.remove('mic-active');
      };
      rec.start();
    });
  });
}

document.addEventListener('DOMContentLoaded', initVoiceInputAndTextareas);
document.addEventListener('astro:page-load', initVoiceInputAndTextareas);

// ── Service worker ──
if('serviceWorker' in navigator){
  window.addEventListener('load',()=>navigator.serviceWorker.register('/sw.js'));
}

window.addEventListener('load', () => {
  // Force scroll containment unlock on all screen views
  document.querySelectorAll('.screen').forEach(el => {
    el.style.setProperty('overflow-y', 'auto', 'important');
    el.style.setProperty('-webkit-overflow-scrolling', 'touch', 'important');
  });

  // Force every form card away from the mobile screen boundaries
  document.querySelectorAll('.form-card').forEach(el => {
    el.style.setProperty('margin', '0 16px 24px 16px', 'important');
    el.style.setProperty('padding', '24px 20px', 'important');
    el.style.setProperty('width', 'calc(100% - 32px)', 'important');
    el.style.setProperty('box-sizing', 'border-box', 'important');
  });

  // Force massive legible fonts and vertical heights onto all fields
  document.querySelectorAll('input, textarea, select, .inp').forEach(el => {
    el.style.setProperty('font-size', '20px', 'important');
    el.style.setProperty('min-height', '60px', 'important');
    el.style.setProperty('height', '60px', 'important');
  });
});
