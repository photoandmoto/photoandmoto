<script>
// ── Categories ──
const CATS = [
  {name:'Enduro',label:'Enduro'},{name:'Interview',label:'Haastattelu'},
  {name:'Profile',label:'Henkilökuva'},{name:'Historical',label:'Historiallinen'},
  {name:'Ice speedway',label:'Ice speedway'},{name:'Long Track',label:'Maarata'},
  {name:'Motocross',label:'Motocross'},{name:'MXGP',label:'MXGP'},
  {name:'Scramble',label:'Scramble'},{name:'Speedway',label:'Speedway'},
  {name:'Technical',label:'Tekninen'},{name:'Trail',label:'Trail'},
];
const CAT_HTML = '<option value="">— valitse kategoria —</option>' +
  CATS.map(c=>`<option value="${c.name}">${c.label}</option>`).join('');

const $=id=>document.getElementById(id);

// Populate category selects
$('fla-cat').innerHTML = CAT_HTML;

// ── Screen management ──
function showScreen(id) {
  document.querySelectorAll('.screen').forEach(s=>{
    s.classList.toggle('active', s.id===id);
  });
}

// ── Toast ──
let toastTimer;
function toast(msg, ms=2800) {
  const el=$('app-toast');
  el.textContent=msg; el.classList.add('visible');
  clearTimeout(toastTimer);
  toastTimer=setTimeout(()=>el.classList.remove('visible'), ms);
}

// ── Auth boot (splash + auth in parallel) ──
let splashDone=false, authResult=null;
function resolveStartup() {
  if (!splashDone || !authResult) return;
  if (authResult.ok) showScreen('screen-home');
  else showScreen('screen-login');
}
showScreen('screen-splash');
setTimeout(()=>{ splashDone=true; resolveStartup(); }, 1500);
(async()=>{
  try {
    const r=await fetch('/api/auth/me',{credentials:'same-origin'});
    if (r.ok) { const d=await r.json(); authResult={ok:!!(d.user?.permissions?.laheta_artikkeli)}; }
    else authResult={ok:false};
  } catch { authResult={ok:false}; }
  resolveStartup();
})();

// ── Login ──
$('login-pw-eye').addEventListener('click',()=>{
  const pw=$('login-pw');
  const show=pw.type==='password';
  pw.type=show?'text':'password';
  $('login-pw-eye').classList.toggle('on',show);
});
$('login-btn').addEventListener('click', async()=>{
  const email=$('login-email').value.trim();
  const pw=$('login-pw').value;
  const err=$('login-err');
  err.style.display='none';
  if(!email||!pw){err.textContent='Anna sähköposti ja salasana.';err.style.display='block';return;}
  const loginBtn=$('login-btn');
  loginBtn.classList.add('btn-loading'); loginBtn.textContent='Kirjaudutaan…';
  try {
    const r=await fetch('/api/auth/login',{
      method:'POST',credentials:'same-origin',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({email,password:pw}),
    });
    if(r.ok){
      $('login-email').value=''; $('login-pw').value='';
      showScreen('screen-home');
    } else {
      err.textContent=r.status===429?'Liian monta yritystä. Yritä myöhemmin.':'Väärät kirjautumistiedot.';
      err.style.display='block';
    }
  } catch {
    err.textContent='Yhteysvirhe — yritä uudelleen.'; err.style.display='block';
  } finally { loginBtn.classList.remove('btn-loading'); loginBtn.textContent='Kirjaudu sisään'; }
});
// Allow Enter key in login fields
[$('login-email'),$('login-pw')].forEach(el=>el.addEventListener('keydown',e=>{if(e.key==='Enter')$('login-btn').click();}));

// ── Logout ──
async function logout() {
  try { await fetch('/api/auth/logout',{method:'POST',credentials:'same-origin'}); } catch {}
  showScreen('screen-login');
}
$('app-logout-btn').addEventListener('click', logout);

// ── Tab switching ──
document.querySelectorAll('.nav-tab').forEach(btn=>{
  btn.addEventListener('click',()=>{
    const tab=btn.dataset.tab;
    document.querySelectorAll('.nav-tab').forEach(b=>b.classList.toggle('active',b===btn));
    document.querySelectorAll('.tab-panel').forEach(p=>p.classList.toggle('active',p.id===`tab-${tab}`));
    document.querySelector('.app-main')?.scrollTo(0,0);
  });
});

// ── File button delegation ──
document.addEventListener('click',e=>{
  const btn=e.target.closest('[data-target]');
  if(!btn||btn.tagName!=='BUTTON') return;
  const t=$(btn.dataset.target); if(t) t.click();
});

// ── File pair helper ──
function setupFilePair(camId, fileId, lblId, onChange) {
  function handle(activeId, otherId) {
    const other=$(otherId); if(other) other.value='';
    const active=$(activeId); const lbl=$(lblId);
    if(lbl){
      if(!active?.files?.length) lbl.textContent='Ei tiedostoa valittu';
      else if(active.files.length>1) lbl.textContent=`${active.files.length} tiedostoa valittu`;
      else lbl.textContent=active.files[0].name;
    }
    if(onChange) onChange();
  }
  $(camId)?.addEventListener('change',()=>handle(camId,fileId));
  $(fileId)?.addEventListener('change',()=>handle(fileId,camId));
}

setupFilePair('fla-ph-cam','fla-ph-file','fla-ph-lbl', null);
setupFilePair('pho-cam','pho-file','pho-lbl', phoFileChanged);

// ── Image helpers ──
function generateThumb(file){
  return new Promise(resolve=>{
    try{
      const reader=new FileReader();
      reader.onload=ev=>{
        const img=new Image();
        img.onload=()=>{
          try{
            const MAX=300; let w=img.width,h=img.height;
            if(w>h){if(w>MAX){h=Math.round(h*(MAX/w));w=MAX;}}
            else{if(h>MAX){w=Math.round(w*(MAX/h));h=MAX;}}
            const c=document.createElement('canvas');
            c.width=w;c.height=h;c.getContext('2d').drawImage(img,0,0,w,h);
            resolve(c.toDataURL('image/jpeg',0.7));
          }catch{resolve(null);}
        };
        img.onerror=()=>resolve(null);
        img.src=ev.target.result;
      };
      reader.onerror=()=>resolve(null);
      reader.readAsDataURL(file);
    }catch{resolve(null);}
  });
}
function resizeMainImage(file){
  return new Promise(resolve=>{
    try{
      const reader=new FileReader();
      reader.onload=ev=>{
        const img=new Image();
        img.onload=()=>{
          try{
            const MAX=1600;
            if(img.width<=MAX&&img.height<=MAX){resolve(file);return;}
            let w=img.width,h=img.height;
            if(w>h){h=Math.round(h*(MAX/w));w=MAX;}
            else{w=Math.round(w*(MAX/h));h=MAX;}
            const c=document.createElement('canvas');
            c.width=w;c.height=h;c.getContext('2d').drawImage(img,0,0,w,h);
            c.toBlob(blob=>{
              if(!blob){resolve(file);return;}
              const name=file.name.replace(/\.(jpe?g|png|webp)$/i,'.jpg');
              resolve(new File([blob],name,{type:'image/jpeg'}));
            },'image/jpeg',0.8);
          }catch{resolve(file);}
        };
        img.onerror=()=>resolve(file);
        img.src=ev.target.result;
      };
      reader.onerror=()=>resolve(file);
      reader.readAsDataURL(file);
    }catch{resolve(file);}
  });
}

