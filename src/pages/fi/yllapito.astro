// =====================================================================
// JULKAISE TAB — staging / production deploy with spinner + countdown
// =====================================================================
// /api/deploy is gated by the pm_session cookie (hallitse_artikkeleita).
// Each button runs its own 3-minute countdown after a successful trigger;
// re-clicking resets it. If the session looks stale on the first POST (the
// cookie occasionally isn't attached right after the Sveltia round-trip), we
// re-validate via /api/auth/me and retry once — so it works without a manual
// page refresh.
const JK_COUNTDOWN_SECONDS = 180;
const jkTimers = { staging: null, production: null };

function jkFmt(s){ const m=Math.floor(s/60); return m+':'+String(s%60).padStart(2,'0'); }

function jkStopCountdown(target, btn){
  if(jkTimers[target]){ clearInterval(jkTimers[target]); jkTimers[target]=null; }
  if(btn){ btn.disabled=false; if(btn.dataset.jkLabel) btn.textContent=btn.dataset.jkLabel; }
}

function jkStartCountdown(target, btn){
  if(!btn.dataset.jkLabel) btn.dataset.jkLabel=btn.textContent;
  if(jkTimers[target]){ clearInterval(jkTimers[target]); jkTimers[target]=null; } // reset on re-click
  let remaining=JK_COUNTDOWN_SECONDS;
  btn.disabled=true;
  const render=()=>{ btn.innerHTML='<span class="jk-spinner" aria-hidden="true"></span><span class="jk-count">'+jkFmt(remaining)+'</span>'; };
  render();
  jkTimers[target]=setInterval(()=>{
    remaining-=1;
    if(remaining<=0){
      clearInterval(jkTimers[target]); jkTimers[target]=null;
      btn.disabled=false; btn.textContent=btn.dataset.jkLabel;
      const msg=document.getElementById('deployMsg');
      if(msg) msg.innerHTML='<span class="u-ok">✓ Valmis — tarkista tulos. Jos sivu ei ole vielä päivittynyt, odota hetki ja päivitä selain.</span>';
    } else {
      render();
    }
  },1000);
}

// POST /api/deploy with one self-healing retry if the session looks stale.
async function jkDeployRequest(target){
  const opts={ method:'POST', credentials:'same-origin', headers:{'Content-Type':'application/json'}, body:JSON.stringify({target}) };
  let r=await fetch('/api/deploy', opts);
  if(r.status===401 || r.status===403){
    try{ const me=await fetch('/api/auth/me',{credentials:'same-origin'}); if(me.ok){ r=await fetch('/api/deploy', opts); } }catch{}
  }
  return r;
}

async function triggerDeploy(target, btn){
  if(!btn) return;
  const msg=document.getElementById('deployMsg');
  jkStartCountdown(target, btn);          // spinner + 3:00, resets if already running
  if(msg) msg.innerHTML='<span class="u-load">Rakennetaan… älä sulje sivua.</span>';
  let ok=false, authFail=false;
  try{
    const r=await jkDeployRequest(target);
    const data=await r.json().catch(()=>({}));
    ok = r.ok && data.ok===true;
    authFail = (r.status===401 || r.status===403);
  }catch(e){ ok=false; }
  if(!ok){
    jkStopCountdown(target, btn);
    if(msg) msg.innerHTML = authFail
      ? '<span class="u-err">✗ Istunto vanhentunut — kirjaudu uudelleen ja yritä uudelleen.</span>'
      : '<span class="u-err">✗ Virhe — yritä uudelleen</span>';
  }
  // On success the countdown keeps running and shows the valmis message at 0:00.
}
