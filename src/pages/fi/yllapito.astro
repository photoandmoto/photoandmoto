  .hallitse-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:16px}
  .hcard{background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,.06)}
