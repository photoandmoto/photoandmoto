  document.getElementById('ktModalSave').style.display = '';
  document.getElementById('ktModalCancel').textContent = 'Peruuta';
  document.getElementById('ktUserModal').style.display = 'flex';
  setTimeout(() => document.getElementById('ktModalFirst').focus(), 50);
}

function ktCloseModal() {
  document.getElementById('ktUserModal').style.display = 'none';
  ktEditingUserId = null;
}

async function ktSubmitModal() {
  const err = document.getElementById('ktModalErr');
  err.style.display = 'none';
  const saveBtn = document.getElementById('ktModalSave');

  const firstName = document.getElementById('ktModalFirst').value.trim();
  const lastName = document.getElementById('ktModalLast').value.trim();
  if (!firstName || !lastName) {
    err.textContent = 'Etunimi ja sukunimi vaaditaan';
    err.style.display = 'block';
    return;
  }

  const body = {
    first_name: firstName,
    last_name: lastName,
    role: document.getElementById('ktModalRole').value,
    permissions: {
      tarkista: document.getElementById('ktPerm_tarkista').checked,
      lahetakuva: document.getElementById('ktPerm_lahetakuva').checked,
      hallitse_galleriaa: document.getElementById('ktPerm_hallitse_galleriaa').checked,
      hallitse_artikkeleita: document.getElementById('ktPerm_hallitse_artikkeleita').checked,
      admin_iam: document.getElementById('ktPerm_admin_iam').checked,
      laheta_artikkeli: document.getElementById('ktPerm_laheta_artikkeli').checked,
    },
  };

  const originalText = saveBtn.textContent;
  saveBtn.disabled = true;
  saveBtn.textContent = 'Tallennetaan…';

  try {
    let r;
    if (ktEditingUserId) {
      r = await fetch(`/api/auth/users/${ktEditingUserId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
    } else {
      body.email = document.getElementById('ktModalEmail').value.trim();
      if (!body.email) {
        err.textContent = 'Sähköposti vaaditaan';
        err.style.display = 'block';
        saveBtn.disabled = false;
        saveBtn.textContent = originalText;
        return;
      }
      r = await fetch('/api/auth/users', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
    }

    const data = await r.json().catch(() => ({}));
    if (!r.ok) {
      err.textContent = data.error || (ktEditingUserId ? 'Tallennus epäonnistui' : 'Käyttäjän luonti epäonnistui');
      err.style.display = 'block';
      saveBtn.disabled = false;
      saveBtn.textContent = originalText;
      return;
    }

    if (ktEditingUserId) {
      ktCloseModal();
      await ktLoadUsers();
    } else {
      // Show the provisioning link; keep the modal open so admin can copy it
      document.getElementById('ktModalLink').value = data.provisioning_link || '';
      document.getElementById('ktModalLinkBox').style.display = 'block';
      saveBtn.style.display = 'none';
      document.getElementById('ktModalCancel').textContent = 'Sulje';
      await ktLoadUsers();
    }
  } catch {
    err.textContent = 'Yhteysvirhe — yritä uudelleen';
    err.style.display = 'block';
    saveBtn.disabled = false;
    saveBtn.textContent = originalText;
  }
}

async function ktRegenerateLink(uid) {
  const u = ktUsers.find(x => x.id === uid);
  if (!u) return;
  const msg = u.is_active
    ? `Luo uusi provisiointilinkki käyttäjälle ${u.first_name} ${u.last_name}?\n\nNykyinen salasana ja palautuskysymykset POISTETAAN. Käyttäjän pitää avata linkki ja asettaa salasana uudelleen.`
    : `Reaktivoi käyttäjä ${u.first_name} ${u.last_name} luomalla uusi provisiointilinkki?`;
  if (!confirm(msg)) return;
  try {
    const r = await fetch(`/api/auth/users/${uid}/regenerate-link`, { method: 'POST' });
    const data = await r.json().catch(() => ({}));
    if (!r.ok) {
      alert(data.error || 'Linkin luonti epäonnistui');
      return;
    }
    window.prompt(`Uusi provisiointilinkki käyttäjälle ${u.first_name} ${u.last_name} (kopioi alta):`, data.provisioning_link || '');
    await ktLoadUsers();
  } catch {
    alert('Yhteysvirhe');
  }
}

async function ktDeactivate(uid) {
  const u = ktUsers.find(x => x.id === uid);
  if (!u) return;
  if (!confirm(`Deaktivoi käyttäjä ${u.first_name} ${u.last_name}?\n\nHänen istuntonsa lopetetaan välittömästi ja hän ei voi enää kirjautua sisään.`)) return;
  try {
    const r = await fetch(`/api/auth/users/${uid}/deactivate`, { method: 'POST' });
    const data = await r.json().catch(() => ({}));
    if (!r.ok) {
      alert(data.error || 'Deaktivointi epäonnistui');
      return;
    }
    await ktLoadUsers();
  } catch {
    alert('Yhteysvirhe');
  }
}

async function ktLoadAudit() {
  const list = document.getElementById('ktAuditList');
  if (!list) return;
  list.innerHTML = '<div class="kt-loading">Ladataan…</div>';
  try {
    const r = await fetch('/api/auth/audit/recoveries');
    if (!r.ok) {
      list.innerHTML = '<div class="kt-empty">Lokia ei voitu ladata</div>';
      return;
    }
    const data = await r.json();
    const attempts = data.attempts || [];
    if (attempts.length === 0) {
      list.innerHTML = '<div class="kt-empty">Ei palautusyrityksiä lokissa.</div>';
      return;
    }
    list.innerHTML = '<ul class="kt-audit-items">' + attempts.map(a => {
      const cls = a.succeeded ? 'ok' : 'fail';
      const icon = a.succeeded ? '✓' : '✗';
      const t = new Date(a.attempted_at).toLocaleString('fi-FI');
      return `<li class="kt-audit-item kt-audit-item--${cls}">
        <span class="kt-audit-icon">${icon}</span>
        <span class="kt-audit-email">${esc(a.email_attempted || '(tuntematon)')}</span>
        <span class="kt-audit-ip">${esc(a.ip || '—')}</span>
        <span class="kt-audit-time">${t}</span>
      </li>`;
    }).join('') + '</ul>';
    ktAuditLoaded = true;
  } catch {
    list.innerHTML = '<div class="kt-empty">Yhteysvirhe</div>';
  }
}

// Event listeners — elements always exist in the DOM (applyPermissions just
// hides the tab button when admin_iam is missing). Bind unconditionally.
if (document.getElementById('ktAddBtn')) {
  document.getElementById('ktAddBtn').addEventListener('click', ktOpenCreateModal);
  document.getElementById('ktModalCancel').addEventListener('click', ktCloseModal);
  document.getElementById('ktModalSave').addEventListener('click', ktSubmitModal);
  document.getElementById('ktTable').addEventListener('click', (e) => {
    const btn = e.target.closest('.kt-action');
    if (!btn) return;
    const uid = parseInt(btn.dataset.uid, 10);
    const act = btn.dataset.act;
    if (act === 'edit') ktOpenEditModal(uid);
    else if (act === 'link') ktRegenerateLink(uid);
    else if (act === 'deactivate') ktDeactivate(uid);
  });
  const copyBtn = document.getElementById('ktModalCopyLink');
  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      const inp = document.getElementById('ktModalLink');
      inp.select();
      try { navigator.clipboard.writeText(inp.value); copyBtn.textContent = '✓ Kopioitu'; setTimeout(() => copyBtn.textContent = '📋 Kopioi linkki', 1500); } catch {}
    });
  }
  // Audit log: lazy-load on first expand
  const auditDetails = document.querySelector('.kt-audit');
  if (auditDetails) {
    auditDetails.addEventListener('toggle', () => {
      if (auditDetails.open && !ktAuditLoaded) ktLoadAudit();
    });
  }
}

</script>

