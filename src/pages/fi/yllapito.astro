  grid.querySelectorAll('.hcard-del').forEach(btn => btn.addEventListener('click', async () => {
    const filename = btn.dataset.filename;
    if (!confirm(`Poistetaanko kuva "${filename}" galleriasta ${hallitseCurrentSlug}? Ei voi peruuttaa.`)) return;
    btn.disabled = true;
    const msg = document.getElementById('hallitseMsg');
    msg.innerHTML = '<span class="u-load">Poistetaan...</span>';
    const r = await fetch('/api/mystery/gallery-manage', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({password: adminPw, action: 'delete_photo', gallery_slug: hallitseCurrentSlug, filename}),
    });
    const data = await r.json();
    if (data.success) {
      msg.innerHTML = `<span class="u-ok">✓ Poistettu: ${esc(filename)}</span>`;
      await loadHallitsePhotos();
    } else {
      msg.innerHTML = `<span class="u-err">Virhe: ${esc(data.error)}</span>`;
      btn.disabled = false;
    }
  }));

  grid.querySelectorAll('.hcard-edit').forEach(btn => btn.addEventListener('click', () => {
    const filename = btn.dataset.filename;
    const currentCaption = btn.dataset.caption;
    // Close any open edit panel
    const existing = document.getElementById('editCaptionPanel');
    if (existing) {
      if (existing.dataset.filename === filename) { existing.remove(); return; }
      existing.remove();
    }
    const card = btn.closest('.hcard');
    const panel = document.createElement('div');
    panel.id = 'editCaptionPanel';
    panel.className = 'edit-caption-panel';
    panel.dataset.filename = filename;
    panel.innerHTML = `
      <label class="edit-caption-panel__label">Kuvateksti</label>
      <input type="text" id="editCaptionInp" class="inp" value="${escAttr(currentCaption)}" />
      <div class="edit-caption-panel__actions">
        <button class="btn btn--ghost edit-caption-cancel">Peruuta</button>
        <button class="btn edit-caption-save">Tallenna</button>
      </div>
      <div id="editCaptionMsg" class="edit-caption-panel__msg"></div>
    `;
    card.after(panel);
    const inp = document.getElementById('editCaptionInp');
    inp.focus();
    inp.select();
    panel.querySelector('.edit-caption-cancel').addEventListener('click', () => panel.remove());
    panel.querySelector('.edit-caption-save').addEventListener('click', async () => {
      const newCaption = inp.value.trim();
      const msg = document.getElementById('editCaptionMsg');
      if (!newCaption) { msg.innerHTML = '<span class="u-err">Kuvateksti ei voi olla tyhjä</span>'; return; }
      if (newCaption === currentCaption) { panel.remove(); return; }
      msg.innerHTML = '<span class="u-load">Tallennetaan...</span>';
      panel.querySelector('.edit-caption-save').disabled = true;
      const r = await fetch('/api/mystery/gallery-manage', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({password: adminPw, action: 'update_caption', gallery_slug: hallitseCurrentSlug, filename, caption: newCaption}),
      });
      const data = await r.json();
      if (data.success) {
        panel.remove();
        document.getElementById('hallitseMsg').innerHTML = '<span class="u-ok">✓ Kuvateksti päivitetty</span>';
        await loadHallitsePhotos();
      } else {
        msg.innerHTML = `<span class="u-err">Virhe: ${esc(data.error)}</span>`;
        panel.querySelector('.edit-caption-save').disabled = false;
      }
    });
    inp.addEventListener('keydown', e => {
      if (e.key === 'Enter') panel.querySelector('.edit-caption-save').click();
      if (e.key === 'Escape') panel.remove();
    });
  }));

  // Move handler — opens inline panel under the card with gallery dropdown
  grid.querySelectorAll('.hcard-move').forEach(btn => btn.addEventListener('click', async () => {
    const filename = btn.dataset.filename;
    // Close any open panels first (edit or move) — same toggle pattern as edit
    const existingEdit = document.getElementById('editCaptionPanel');
    if (existingEdit) existingEdit.remove();
    const existingMove = document.getElementById('movePhotoPanel');
    if (existingMove) {
      if (existingMove.dataset.filename === filename) { existingMove.remove(); return; }
      existingMove.remove();
    }
    const card = btn.closest('.hcard');
    const panel = document.createElement('div');
    panel.id = 'movePhotoPanel';
    panel.className = 'edit-caption-panel';
    panel.dataset.filename = filename;
    panel.innerHTML = `
      <label class="edit-caption-panel__label">Siirrä galleriaan</label>
      <select id="movePhotoSelect" class="inp"><option value="">— ladataan gallerioita —</option></select>
      <div class="edit-caption-panel__actions">
        <button class="btn btn--ghost move-photo-cancel">Peruuta</button>
        <button class="btn move-photo-confirm" disabled>Siirrä</button>
      </div>
      <div id="movePhotoMsg" class="edit-caption-panel__msg"></div>
    `;
    card.after(panel);

    // Populate dropdown — exclude the source gallery
    const select = document.getElementById('movePhotoSelect');
    const confirmBtn = panel.querySelector('.move-photo-confirm');
    try {
      const galleries = await loadGalleries();
      const others = galleries.filter(g => g.slug !== hallitseCurrentSlug);
      if (others.length === 0) {
        select.innerHTML = '<option value="">Ei muita gallerioita</option>';
      } else {
        select.innerHTML = '<option value="">— valitse galleria —</option>' +
          others.map(g => `<option value="${escAttr(g.slug)}">${esc(g.title)}</option>`).join('');
      }
    } catch(e) {
      select.innerHTML = '<option value="">Virhe ladattaessa</option>';
    }
    select.addEventListener('change', () => { confirmBtn.disabled = !select.value; });

    panel.querySelector('.move-photo-cancel').addEventListener('click', () => panel.remove());
    confirmBtn.addEventListener('click', async () => {
      const targetSlug = select.value;
      if (!targetSlug) return;
      const msg = document.getElementById('movePhotoMsg');
      msg.innerHTML = '<span class="u-load">Siirretään... (voi kestää 10–30 s)</span>';
      confirmBtn.disabled = true;
      panel.querySelector('.move-photo-cancel').disabled = true;
      try {
        const r = await fetch('/api/mystery/gallery-manage', {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({password: adminPw, action: 'move_photo', gallery_slug: hallitseCurrentSlug, filename, target_slug: targetSlug}),
        });
        const data = await r.json();
        if (data.success) {
          panel.remove();
          document.getElementById('hallitseMsg').innerHTML = `<span class="u-ok">✓ Siirretty galleriaan ${esc(targetSlug)}</span>`;
          await loadHallitsePhotos();
        } else {
          msg.innerHTML = `<span class="u-err">Virhe: ${esc(data.error || 'Tuntematon virhe')}</span>`;
          confirmBtn.disabled = false;
          panel.querySelector('.move-photo-cancel').disabled = false;
        }
      } catch(e) {
        msg.innerHTML = `<span class="u-err">Verkkovirhe: ${esc(e.message)}</span>`;
        confirmBtn.disabled = false;
        panel.querySelector('.move-photo-cancel').disabled = false;
      }
    });
  }));
}


// Gallery search filter
function initHallitseSearch() {
  const inp = document.getElementById('hallitseSearch');
  const row = document.getElementById('hallitseSearchRow');
  const count = document.getElementById('hallitseSearchCount');
  if (!inp) return;
  row.style.display = 'flex';
  inp.value = '';
  inp.addEventListener('input', () => {
    const q = inp.value.trim().toLowerCase();
    const cards = document.querySelectorAll('#hallitseGrid .hcard');
    let visible = 0;
    cards.forEach(card => {
      const caption = (card.querySelector('.hcard-caption')?.textContent || '').toLowerCase();
      const show = !q || caption.includes(q);
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    count.textContent = q ? `${visible} tulosta` : '';
    // Also hide edit panel if open
    const ep = document.getElementById('editCaptionPanel');
    if (ep && q) ep.remove();
  });
}

