  document.getElementById('ktPerm_lahetakuva').checked = !!u.permissions.lahetakuva;
  document.getElementById('ktPerm_hallitse_galleriaa').checked = !!u.permissions.hallitse_galleriaa;
  document.getElementById('ktPerm_hallitse_artikkeleita').checked = !!u.permissions.hallitse_artikkeleita;
  document.getElementById('ktPerm_admin_iam').checked = !!u.permissions.admin_iam;
  document.getElementById('ktPerm_laheta_artikkeli').checked = !!u.permissions.laheta_artikkeli;
