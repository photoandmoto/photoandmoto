.af-status--new{background:#fff3e0;color:#a06400;border:1px solid #ffd89a}
.af-status--partial{background:#e6f2fd;color:#1265b5;border:1px solid #b3d4ef}
.af-status--identified{background:#e8f5e9;color:#2e7d32;border:1px solid #a8d6a8}
.af-status__dot{width:8px;height:8px;border-radius:50%;background:currentColor;opacity:.7;flex-shrink:0}
.af-status__detail{font-weight:400;opacity:.75;font-size:.82rem}

/* ===== ADMIN FOOTER (Julkaise + Poista) ===== */
.af-footer{display:flex;align-items:center;gap:12px;margin-top:14px;padding-top:14px;border-top:1px solid #f0f0f0}
.btn--secondary{background:#fff;color:#333;border:1.5px solid #ddd;padding:10px 18px;font-size:.82rem;border-radius:10px;flex:1;cursor:pointer;font-weight:700;transition:all .2s;font-family:'DM Sans',sans-serif}
.btn--secondary:hover:not(:disabled){border-color:#ff9900;color:#ff9900;transform:translateY(-1px);box-shadow:0 4px 12px rgba(255,153,0,.15)}
.btn--secondary:disabled{opacity:.5;cursor:not-allowed;background:#fafafa;color:#999;border-color:#e5e5e5}
.af-footer__del{background:none;border:none;color:#bbb;font-size:.78rem;cursor:pointer;padding:8px 12px;border-radius:6px;transition:all .15s;font-weight:600;font-family:'DM Sans',sans-serif;white-space:nowrap}
.af-footer__del:hover{background:#fde8e8;color:#dc3545}

/* ===== PUBLISH PANEL (inline confirm UI for Julkaise Galleriaan) ===== */
.pub-panel{
  margin-top:14px;
  padding:14px 16px;
  background:#fffaf2;
  border:1.5px solid #ffd89a;
  border-radius:12px;
  animation:pubFadeIn .2s ease-out;
}
@keyframes pubFadeIn{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:translateY(0)}}
.pub-panel__header{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}
.pub-panel__header h4{font-family:var(--font-headline);font-size:.95rem;font-weight:800;color:#a06400;margin:0;letter-spacing:.2px}
.pub-panel__close{background:none;border:none;color:#a06400;cursor:pointer;font-size:.95rem;padding:4px 8px;border-radius:6px;line-height:1;transition:background .15s}
.pub-panel__close:hover{background:rgba(255,153,0,.12)}
.ab-save-msg{margin-top:8px;font-size:.85rem;font-weight:600;min-height:1.2em;text-align:center;transition:opacity .2s}
.ab-save-msg--ok{color:#1a8c3a}
.ab-save-msg--err{color:#c0392b}
.pub-panel__body{display:flex;flex-direction:column;gap:10px}
.pub-row{display:flex;flex-direction:column;gap:4px}
.pub-row label{font-size:.74rem;font-weight:700;color:#a06400;text-transform:uppercase;letter-spacing:.5px}
.pub-row .inp{width:100%}
.pub-select-row{display:flex;gap:8px;align-items:center}
.pub-select-row .inp--sel{width:100%;max-width:none}
.pub-newbox{padding-top:6px}
.pub-hint{font-size:.74rem;color:#8a6630;line-height:1.4;margin-top:2px}
.pub-actions{display:flex;gap:10px;align-items:center;justify-content:flex-end;margin-top:4px}
.pub-msg{min-height:1.2em;font-size:.85rem;text-align:right}
.pub-loading{padding:12px;text-align:center;color:#a06400;font-size:.88rem;font-weight:600}

/* ===== ADMIN FIELD REVIEW (field-grouped suggestions + manual input) ===== */
.af-field{padding-bottom:14px;border-bottom:1px solid #f0f0f0;margin-bottom:14px}
.af-field:last-of-type{border-bottom:none}
.af-field__head{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:6px;gap:8px}
.af-field__head label{font-size:.78rem;font-weight:700;color:#888;margin:0;text-transform:uppercase;letter-spacing:.5px}
.af-field__count{font-size:.7rem;color:#ff9900;font-weight:700;white-space:nowrap}
.af-suggs{display:flex;flex-direction:column;margin-bottom:8px;background:#fafaf8;border-radius:8px;padding:2px 10px;border:1px solid #efece4}
.af-sugg{padding:7px 0;border-bottom:1px dashed #e8e4d7}
.af-sugg:last-child{border-bottom:none}
.af-sugg__main{display:flex;align-items:flex-start;justify-content:space-between;gap:8px}
.af-sugg__text{font-size:.88rem;font-weight:600;color:#222;flex:1;line-height:1.3;word-break:break-word}
.af-sugg__actions{display:flex;gap:4px;align-items:center;flex-shrink:0}
.af-sugg__copy{background:none;border:none;color:#ff9900;font-size:.72rem;font-weight:700;cursor:pointer;padding:2px 6px;border-radius:4px;transition:background .15s;white-space:nowrap}
.af-sugg__copy:hover{background:#fff3e0;text-decoration:underline}
.af-sugg__del{background:none;border:none;color:#bbb;font-size:.82rem;cursor:pointer;padding:2px 4px;border-radius:4px;transition:all .15s;line-height:1}
.af-sugg__del:hover{background:#fde8e8;color:#dc3545}
.af-sugg__meta{font-size:.68rem;color:#a8a8a8;margin-top:2px}
.af-empty{font-size:.78rem;color:#bbb;font-style:italic;margin:0 0 8px;padding:4px 0}
.af-input{width:100%;transition:border-color .2s, box-shadow .2s}

/* Confirmed-field visual: subtle green accent when an input has a saved value */
.af-input--done{border-left:3px solid #2e7d32}
.af-field--done .af-field__head label::after{content:" ✓";color:#2e7d32;font-weight:700;font-size:.85rem}

/* Reply context — the ↳ arrow and "vastaus: ..." meta label for threaded suggestions */
.af-sugg--reply{padding-left:10px;border-left:2px solid #eee8d6;margin-left:6px}
.af-sugg__arrow{color:#b08030;font-weight:700;margin-right:2px}
.af-sugg__replyctx{font-style:italic;color:#9a7a3a}

/* ===== THREAD CARD ===== */
.thread-card{background:transparent;border-radius:14px;padding:0;box-sizing:border-box;display:flex;flex-direction:column}
.thread-card__header{margin-bottom:16px;padding-bottom:12px;border-bottom:1px solid rgba(255,255,255,.15)}
.thread-card__header h3{font-family:var(--font-headline);font-size:1.05rem;font-weight:800;margin:0;color:#fff}
.thread-empty{color:#888;font-style:italic;font-size:.9rem;padding:32px 0;display:flex;align-items:center;justify-content:center;gap:14px;flex-wrap:wrap}
.thread-empty__arrow{display:inline-block;font-size:1.6rem;font-style:normal;color:#ff9900;font-weight:700;line-height:1;animation:thread-empty-bounce 1.6s ease-in-out infinite}
.thread-empty__text{font-style:italic}
@keyframes thread-empty-bounce{0%,100%{transform:translateX(0)}50%{transform:translateX(-6px)}}
.thread-list{display:flex;flex-direction:column;gap:16px}

/* ===== POST (thread item) ===== */
.post{background:#fff;border-radius:12px;padding:16px;border:1px solid #e8e8e8}
.post--alt{background:#f2ead9}
.post--child{margin-left:32px;border-left:3px solid #ff9900;border-radius:0 12px 12px 0;padding:14px 16px}
.post-header{display:flex;align-items:center;gap:8px;margin-bottom:6px;flex-wrap:wrap}
.post-tag{font-size:.6rem;font-weight:700;color:#fff;background:#ff9900;padding:3px 10px;border-radius:20px;text-transform:uppercase;letter-spacing:.8px}
.post-author{font-size:.88rem;font-weight:700;color:#333}
.post-date{font-size:.72rem;color:#bbb;margin-left:auto}
.post-del{background:none;border:none;cursor:pointer;font-size:.82rem;opacity:.3;padding:0;transition:opacity .2s}
.post-del:hover{opacity:1}
.post-body{font-size:.92rem;color:#333;margin:0 0 10px;line-height:1.6}
.post-actions{display:flex;gap:8px;align-items:center}

/* ===== VOTE BUTTONS ===== */
.th-vote{background:#fff;border:1.5px solid #e0e0e0;border-radius:20px;padding:4px 14px;font-size:.8rem;cursor:pointer;transition:all .2s;display:inline-flex;align-items:center;gap:4px}
.th-vote:hover{border-color:#ff9900;background:#fff8ee}
.th-vote--on{background:#fff3e0;border-color:#ff9900;font-weight:700}
.th-vote span{font-weight:600;font-size:.78rem}

/* ===== REPLY ===== */
.post-reply-btn{background:none;border:none;font-size:.8rem;color:#ff9900;cursor:pointer;font-weight:700;transition:color .2s}
.post-reply-btn:hover{color:#cc7a00;text-decoration:underline}
.post-reply-box{display:flex;gap:8px;margin-top:12px;padding-top:12px;border-top:1px solid #eee}
.post-reply-inp{flex:1}

/* ===== RESPONSIVE =====
   Mobile: whole lightbox scrolls as one unit, columns don't scroll internally.
   Overrides desktop flex/overflow architecture. */
@media(max-width:900px){
  .photo-grid{grid-template-columns:repeat(2,1fr)}
  .lightbox{height:auto;max-height:95vh;overflow-y:auto;display:block}
  .lb-layout{grid-template-columns:1fr;flex:none;min-height:auto}
  .lb-left{overflow:visible;min-height:auto;padding-right:0}
  .lb-right{overflow:visible;min-height:auto;padding-right:0}
  .upload-grid{grid-template-columns:1fr}
}
@media(max-width:540px){
  .photo-grid{grid-template-columns:1fr}
  .mp-title{font-size:1.6rem}
  .mp-header{flex-direction:column}
}


  /* === UI fixes: orange banners, transparent cards, Close button === */
