  .kt-perms-legend{padding:10px 14px;background:#fafaf8;border-top:1px solid #eee;font-size:.72rem;color:#888;display:flex;gap:6px;flex-wrap:wrap;align-items:center}
  .kt-perms-legend strong{color:#555;font-weight:700;margin-right:4px}
  .kt-badge--contributor{background:#e8f5e9;color:#2e7d32}

  /* Audit log */
  .kt-audit{margin-top:20px;background:#fff;border-radius:8px;padding:0;border:1px solid #eee}
  .kt-audit summary{padding:10px 14px;cursor:pointer;font-weight:600;color:#666;font-size:.85rem;list-style:none}
  .kt-audit summary::-webkit-details-marker{display:none}
  .kt-audit summary::before{content:'▸ ';color:#ff9900}
