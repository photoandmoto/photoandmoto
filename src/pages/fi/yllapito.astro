function openRenameGalleryPanel() {
  const currentTitle = document.getElementById('hallitseGallerySelect').selectedOptions[0]?.text || '';
  const existing = document.getElementById('renameGalleryPanel');
  if (existing) { existing.remove(); return; }
  // Close delete panel if open
  const delPanel = document.getElementById('deleteGalleryPanel');
  if (delPanel) delPanel.remove();

  const panel = document.createElement('div');
  panel.id = 'renameGalleryPanel';
  panel.className = 'del-gallery-panel';
  panel.innerHTML = `
    <div class="del-gallery-panel__header">
      <span class="del-gallery-panel__icon">✏</span>
      <strong>Muuta gallerian nimeä</strong>
    </div>
    <div class="del-gallery-panel__auth">
      <label>Uusi nimi</label>
      <input type="text" id="renameGalleryInp" class="inp" value="${escAttr(currentTitle)}" placeholder="Gallerian nimi" style="max-width:320px;margin-bottom:10px;" />
      <label>Vahvista salasanalla</label>
      <input type="password" id="renameGalleryPw" class="inp" placeholder="Salasana" autocomplete="off" style="max-width:260px;" />
    </div>
    <div class="del-gallery-panel__actions">
      <button class="btn btn--ghost" id="renameGalleryCancel">Peruuta</button>
      <button class="btn" id="renameGalleryConfirm">Tallenna nimi</button>
    </div>
    <div id="renameGalleryMsg" class="del-gallery-panel__msg"></div>
  `;

  const actions = document.getElementById('hallitseGalleryActions');
  actions.parentNode.insertBefore(panel, actions.nextSibling);

  const inp = document.getElementById('renameGalleryInp');
  inp.focus();
  inp.select();

  document.getElementById('renameGalleryCancel').addEventListener('click', () => panel.remove());
  document.getElementById('renameGalleryConfirm').addEventListener('click', async () => {
    const newTitle = inp.value.trim();
    const pw = document.getElementById('renameGalleryPw').value;
    const msg = document.getElementById('renameGalleryMsg');
    if (!newTitle) { msg.innerHTML = '<span class="u-err">Nimi ei voi olla tyhjä</span>'; return; }
    if (!pw) { msg.innerHTML = '<span class="u-err">Syötä salasana</span>'; return; }
    if (pw !== adminPw) { msg.innerHTML = '<span class="u-err">Väärä salasana</span>'; return; }
    if (newTitle === currentTitle) { panel.remove(); return; }
    msg.innerHTML = '<span class="u-load">Tallennetaan...</span>';
    document.getElementById('renameGalleryConfirm').disabled = true;
    const r = await fetch('/api/mystery/gallery-manage', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({password: adminPw, action: 'rename_gallery', gallery_slug: hallitseCurrentSlug, title: newTitle}),
    });
    const data = await r.json();
    if (data.success) {
      panel.remove();
      document.getElementById('hallitseMsg').innerHTML = `<span class="u-ok">✓ Nimi päivitetty: ${esc(data.title)}</span>`;
      cachedGalleries = null;
      await loadHallitseGalleries();
    } else {
      msg.innerHTML = `<span class="u-err">Virhe: ${esc(data.error)}</span>`;
      document.getElementById('renameGalleryConfirm').disabled = false;
    }
  });
}

