let ktUsers = [];
let ktAuditLoaded = false;
let ktEditingUserId = null;

async function ktLoadUsers() {
  const c = document.getElementById('ktTable');
  if (!c) return;
  c.innerHTML = '<div class="kt-loading">Ladataan käyttäjiä…</div>';
  try {
    const r = await fetch('/api/auth/users');
    if (!r.ok) {
      c.innerHTML = '<div class="kt-error">Käyttäjälistan lataus epäonnistui</div>';
      return;
    }
    const data = await r.json();
    ktUsers = data.users || [];
    ktRenderTable();
  } catch {
    c.innerHTML = '<div class="kt-error">Yhteysvirhe</div>';
  }
}

function ktPermsBadges(p) {
  const out = [];
  if (p.tarkista) out.push('<span class="kt-badge" title="Tarkista">T</span>');
  if (p.lahetakuva) out.push('<span class="kt-badge" title="Lähetä kuva">L</span>');
  if (p.hallitse_galleriaa) out.push('<span class="kt-badge" title="Hallitse galleriaa">G</span>');
  if (p.hallitse_artikkeleita) out.push('<span class="kt-badge" title="Hallitse artikkeleita">A</span>');
  if (p.admin_iam) out.push('<span class="kt-badge kt-badge--admin" title="Hallitse käyttäjiä">I</span>');
  if (p.laheta_artikkeli) out.push('<span class="kt-badge kt-badge--contributor" title="Yleinen Kynä">YK</span>');
  return out.join(' ') || '<span class="kt-badge-empty">—</span>';
}

function ktRenderTable() {
  const c = document.getElementById('ktTable');
  if (!c) return;
  if (ktUsers.length === 0) {
    c.innerHTML = '<div class="kt-empty">Ei käyttäjiä.</div>';
    return;
  }
  const rows = ktUsers.map(u => {
    const status = u.is_active
      ? '<span class="kt-status kt-status--active">✓ Aktiivinen</span>'
      : '<span class="kt-status kt-status--inactive">⛔ Deaktivoitu</span>';
    const lastLogin = u.last_login_at
      ? new Date(u.last_login_at).toLocaleString('fi-FI', { dateStyle: 'short', timeStyle: 'short' })
      : '—';
    const actions = u.is_active
      ? `<button class="kt-action" data-act="edit" data-uid="${u.id}">Muokkaa</button>
         <button class="kt-action" data-act="link" data-uid="${u.id}">Uusi linkki</button>
         <button class="kt-action kt-action--danger" data-act="deactivate" data-uid="${u.id}">Poista</button>`
      : `<button class="kt-action" data-act="link" data-uid="${u.id}">Uusi linkki</button>`;
    return `<tr data-uid="${u.id}">
      <td><strong>${esc(u.first_name)} ${esc(u.last_name)}</strong></td>
      <td class="kt-email">${esc(u.email)}</td>
      <td><span class="kt-role kt-role--${esc(u.role)}">${esc(u.role)}</span></td>
      <td class="kt-perms-cell">${ktPermsBadges(u.permissions || {})}</td>
      <td>${status}</td>
      <td class="kt-time">${lastLogin}</td>
      <td class="kt-actions-cell">${actions}</td>
    </tr>`;
  }).join('');
  c.innerHTML = `<table class="kt-table">
    <thead><tr>
      <th>Nimi</th><th>Sähköposti</th><th>Rooli</th><th>Oikeudet</th><th>Tila</th><th>Kirjautunut</th><th></th>
    </tr></thead>
    <tbody>${rows}</tbody>
  </table>
  <div class="kt-perms-legend">
    <strong>Oikeudet:</strong>
    <span><span class="kt-badge">T</span> Tarkista</span> ·
    <span><span class="kt-badge">L</span> Lähetä kuva</span> ·
    <span><span class="kt-badge">G</span> Hallitse galleriaa</span> ·
    <span><span class="kt-badge">A</span> Hallitse artikkeleita</span> ·
    <span><span class="kt-badge kt-badge--admin">I</span> Hallitse käyttäjiä</span> ·
    <span><span class="kt-badge kt-badge--contributor">YK</span> Yleinen Kynä</span>
  </div>`;
}

