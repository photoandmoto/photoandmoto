function openDeleteGalleryPanel() {
  const title = document.getElementById('hallitseGallerySelect').selectedOptions[0]?.text || hallitseCurrentSlug;
  // Remove existing panel if any
  const existing = document.getElementById('deleteGalleryPanel');
  if (existing) { existing.remove(); return; }

  const panel = document.createElement('div');
  panel.id = 'deleteGalleryPanel';
  panel.className = 'del-gallery-panel';
  panel.innerHTML = `
    <div class="del-gallery-panel__header">
      <span class="del-gallery-panel__icon">⚠</span>
      <strong>Poistetaanko galleria "${esc(title)}"?</strong>
    </div>
    <p class="del-gallery-panel__info">Galleria poistetaan sivustolta seuraavassa käännöksessä. Kuvatiedostot säilyvät repossa.</p>
    <div class="del-gallery-panel__auth">
      <label>Vahvista salasanalla</label>
      <input type="password" id="delGalleryPw" class="inp" placeholder="Salasana" autocomplete="off" />
    </div>
    <div class="del-gallery-panel__actions">
      <button class="btn btn--ghost" id="delGalleryCancel">Peruuta</button>
      <button class="btn btn--danger" id="delGalleryConfirm">Poista galleria</button>
    </div>
    <div id="delGalleryMsg" class="del-gallery-panel__msg"></div>
  `;

  // Insert panel after the gallery actions row
  const actions = document.getElementById('hallitseGalleryActions');
  actions.parentNode.insertBefore(panel, actions.nextSibling);

  document.getElementById('delGalleryCancel').addEventListener('click', () => panel.remove());

  document.getElementById('delGalleryConfirm').addEventListener('click', async () => {
    const pw = document.getElementById('delGalleryPw').value;
    const msg = document.getElementById('delGalleryMsg');
    if (!pw) { msg.innerHTML = '<span class="u-err">Syötä salasana</span>'; return; }
    if (pw !== adminPw) { msg.innerHTML = '<span class="u-err">Väärä salasana</span>'; return; }

    msg.innerHTML = '<span class="u-load">Poistetaan...</span>';
    document.getElementById('delGalleryConfirm').disabled = true;

    const r = await fetch('/api/mystery/gallery-manage', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({password: adminPw, action: 'delete_gallery', gallery_slug: hallitseCurrentSlug}),
    });
    const data = await r.json();
    if (data.success) {
      panel.remove();
      document.getElementById('hallitseMsg').innerHTML = `<span class="u-ok">✓ Galleria poistettu</span>`;
      document.getElementById('hallitseGalleryActions').style.display = 'none';
      document.getElementById('hallitseGrid').innerHTML = '';
      hallitseCurrentSlug = null;
      hallitsePhotos = [];
      cachedGalleries = null;
      await loadHallitseGalleries();
    } else {
      msg.innerHTML = `<span class="u-err">Virhe: ${esc(data.error)}</span>`;
      document.getElementById('delGalleryConfirm').disabled = false;
    }
  });

  document.getElementById('delGalleryPw').focus();
}

