        <button class="btn btn--ghost hcard-edit" data-filename="${escAttr(p.filename)}" data-caption="${escAttr(p.caption)}" title="Muokkaa kuvatekstiä">✏</button>
        <button class="btn btn--ghost hcard-move" data-filename="${escAttr(p.filename)}" title="Siirrä toiseen galleriaan">→</button>
        <button class="btn btn--danger hcard-del" data-filename="${escAttr(p.filename)}" title="Poista kuva">🗑</button>
      </div>
