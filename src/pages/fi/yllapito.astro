  /* === Layout: photo on top, form + thread side by side === */
  #modal .lightbox-close,
  .lightbox-close {
    position: absolute !important;
    top: 16px !important;
    right: 16px !important;
    z-index: 100 !important;
  }
  #modal .lb-layout,
  .lb-layout {
    display: grid !important;
    grid-template-columns: 1fr 1fr !important;
    grid-template-areas:
      "photo photo"
      "form thread" !important;
    gap: var(--space-3) !important;
    padding-top: 60px !important;
  }
  #modal .lb-thumb-card,
  .lb-thumb-card {
    grid-area: photo !important;
    margin: 0 !important;
    max-height: 280px !important;
  }
  #modal .lb-left,
  .lb-left {
    display: contents !important;
  }
  #modal .lb-form-wrap,
  .lb-form-wrap {
    grid-area: form !important;
    padding-top: 0 !important;
  }
  #modal .lb-right,
  .lb-right {
    grid-area: thread !important;
    padding-top: 0 !important;
  }
  /* Form fields padding when expanded */
  .form-card.expanded .form-fields {
    padding: var(--space-3) var(--space-3) 0 var(--space-3) !important;
  }
  .form-card.expanded .form-locked {
    padding: var(--space-3) var(--space-3) 0 var(--space-3) !important;
  }
  /* Mobile: stack everything */
  @media (max-width: 700px) {
    #modal .lb-layout,
    .lb-layout {
      grid-template-columns: 1fr !important;
      grid-template-areas:
        "photo"
        "form"
        "thread" !important;
    }
  }


  /* === Final UI fixes === */

  /* Fix 1: Equal height banners */
  .lb-form-wrap .form-card,
  .lb-right .thread-card {
    display: flex;
    flex-direction: column;
  }
  .lb-form-wrap > div,
  .lb-right > div {
    min-height: 80px;
  }
  .form-card__header,
  .thread-card__header {
    min-height: 80px !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
  }

  /* Style for "Click to open" hint */
