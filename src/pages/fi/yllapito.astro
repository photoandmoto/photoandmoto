  .kt-badge-empty{color:#bbb;font-style:italic;font-size:.78rem}
  .kt-actions-cell{display:flex;gap:4px;flex-wrap:wrap;justify-content:flex-end}
  .kt-action{background:none;border:1px solid #ddd;color:#555;font-size:.72rem;font-weight:600;padding:4px 10px;border-radius:4px;cursor:pointer;transition:all .15s;font-family:'DM Sans',sans-serif}
