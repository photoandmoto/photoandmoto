---
// Script-free social share links.
// No SDKs, no cookies, no third-party JS — just plain <a> links that open the
// visitor's own WhatsApp / Facebook / Telegram / email with the page pre-filled.
// Facebook scrapes title + image from the page's existing og: tags, so only the
// URL is passed to it.
//
// Usage:
//   <ShareLinks title={frontmatter.title} lang={lang} />
// url defaults to the current page (absolute, trailing slash stripped).

interface Props {
  title: string;
  lang: 'fi' | 'en';
  url?: string;
  kind?: 'story' | 'gallery';
}

const { title, lang, url, kind = 'story' } = Astro.props;

const siteUrl = import.meta.env.SITE || 'https://www.photoandmoto.fi';
const shareUrl = url || (siteUrl + Astro.url.pathname.replace(/\/+$/, ''));

const encUrl = encodeURIComponent(shareUrl);
const encText = encodeURIComponent(title);

const headings = {
  story: { fi: 'Jaa tämä juttu', en: 'Share this story' },
  gallery: { fi: 'Jaa tämä galleria', en: 'Share this gallery' },
};
const heading = headings[kind][lang];
const emailSubject = encodeURIComponent(title);

const links = [
  {
    name: 'WhatsApp',
    href: `https://wa.me/?text=${encText}%20${encUrl}`,
    icon: 'M17.6 6.3A7.85 7.85 0 0 0 12 4a7.94 7.94 0 0 0-6.9 11.9L4 20l4.2-1.1A7.9 7.9 0 0 0 12 20a7.94 7.94 0 0 0 5.6-13.7ZM12 18.5a6.6 6.6 0 0 1-3.4-.9l-.24-.15-2.5.66.67-2.44-.16-.25A6.6 6.6 0 1 1 12 18.5Zm3.6-4.94c-.2-.1-1.17-.58-1.35-.64s-.31-.1-.44.1-.51.64-.63.77-.23.15-.43.05a5.4 5.4 0 0 1-1.6-.98 6 6 0 0 1-1.1-1.37c-.12-.2 0-.31.09-.41s.2-.23.3-.35a1.4 1.4 0 0 0 .2-.33.37.37 0 0 0 0-.35c0-.1-.44-1.06-.6-1.45s-.32-.33-.44-.34h-.38a.72.72 0 0 0-.52.24 2.2 2.2 0 0 0-.68 1.63 3.83 3.83 0 0 0 .8 2.02 8.75 8.75 0 0 0 3.35 2.96c.47.2.83.32 1.11.42a2.7 2.7 0 0 0 1.23.08 2 2 0 0 0 1.31-.93 1.63 1.63 0 0 0 .11-.92c-.05-.08-.18-.13-.38-.23Z',
    color: '#1D9E75',
  },
  {
    name: 'Facebook',
    href: `https://www.facebook.com/sharer/sharer.php?u=${encUrl}`,
    icon: 'M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12Z',
    color: '#185FA5',
  },
  {
    name: 'X',
    href: `https://twitter.com/intent/tweet?url=${encUrl}&text=${encText}`,
    icon: 'M18.9 3H21.6l-5.9 6.7L22.6 21h-5.4l-4.3-5.6L8 21H5.3l6.3-7.2L4.7 3h5.5l3.9 5.1L18.9 3Zm-1 16.4h1.5L9 4.5H7.4l10.5 14.9Z',
    color: '#0f1419',
  },
  {
    name: lang === 'fi' ? 'Sähköposti' : 'Email',
    href: `mailto:?subject=${emailSubject}&body=${encUrl}`,
    icon: 'M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5-8-5V6l8 5 8-5Z',
    color: '#5F5E5A',
  },
];
---

<aside class="share-links" aria-label={heading}>
  <span class="share-links__heading">{heading}</span>
  <div class="share-links__row">
    {links.map(link => (
      <a
        class="share-links__btn"
        href={link.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${heading}: ${link.name}`}
      >
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
          <path d={link.icon} fill={link.color} />
        </svg>
        <span>{link.name}</span>
      </a>
    ))}
  </div>
</aside>

<style>
  .share-links {
    max-width: 760px;
    margin: var(--space-5) auto 0;
    padding-top: var(--space-4);
    border-top: 2px solid var(--bg-secondary);
  }

  .share-links__heading {
    display: block;
    font-family: var(--font-headline);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-secondary);
    margin-bottom: var(--space-2);
  }

  .share-links__row {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .share-links__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border: 1px solid #d8d0c4;
    border-radius: var(--radius-md);
    font-size: 0.95rem;
    color: var(--text-primary);
    text-decoration: none;
    background: var(--bg-primary, #fff);
    transition: border-color var(--transition-fast), background var(--transition-fast);
  }

  .share-links__btn:hover {
    border-color: #A85D00;
    background: var(--bg-secondary);
    text-decoration: none;
  }

  .share-links__btn svg {
    flex-shrink: 0;
  }

  @media (max-width: 480px) {
    .share-links__btn span {
      /* Keep labels on narrow screens; icons alone can be ambiguous. */
      display: inline;
    }
  }
</style>
