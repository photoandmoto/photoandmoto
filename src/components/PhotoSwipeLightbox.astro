---
// PhotoSwipe lightbox with download prevention
---

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/photoswipe@5.4.3/dist/photoswipe.css">

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import PhotoSwipe from 'photoswipe';
  
  const lightbox = new PhotoSwipeLightbox({
    gallery: '#gallery',
    children: 'a',
    pswpModule: PhotoSwipe,
    
    bgOpacity: 0.95,
    loop: true,
    zoom: true,
    preload: [1, 2],
    
    showHideAnimationType: 'fade',
    padding: { top: 20, bottom: 60, left: 20, right: 20 },
    
    imageClickAction: 'zoom',
    tapAction: 'close',
  });
  
  // Add caption
  lightbox.on('uiRegister', function() {
    lightbox.pswp.ui.registerElement({
      name: 'custom-caption',
      order: 9,
      isButton: false,
      appendTo: 'root',
      html: '',
      onInit: (el, pswp) => {
        el.style.cssText = 'position:absolute;bottom:10px;left:50%;transform:translateX(-50%);background:rgba(0,0,0,0.8);color:white;padding:8px 20px;border-radius:8px;font-size:14px;max-width:80%;text-align:center;pointer-events:none;';
        
        pswp.on('change', () => {
          const currSlideElement = pswp.currSlide.data.element;
          let captionHTML = '';
          if (currSlideElement) {
            const caption = currSlideElement.getAttribute('data-pswp-caption');
            if (caption) captionHTML = caption;
          }
          el.innerHTML = captionHTML || '';
          el.style.display = captionHTML ? 'block' : 'none';
        });
      }
    });
  });
  
  // Prevent download in lightbox
  lightbox.on('afterInit', () => {
    const pswpEl = document.querySelector('.pswp');
    if (pswpEl) {
      pswpEl.addEventListener('contextmenu', (e) => e.preventDefault());
      pswpEl.querySelectorAll('img').forEach(img => {
        img.setAttribute('draggable', 'false');
      });
    }
  });
  
  // Prevent drag on dynamically loaded images
  lightbox.on('change', () => {
    const pswpEl = document.querySelector('.pswp');
    if (pswpEl) {
      pswpEl.querySelectorAll('img').forEach(img => {
        img.setAttribute('draggable', 'false');
        img.style.userSelect = 'none';
        img.style.webkitUserDrag = 'none';
      });
    }
  });
  
  lightbox.init();

  // ---- Filtered navigation ----
  // When the in-gallery filter is active (#gallery[data-filtered]), the prev/next
  // arrows should cycle ONLY the matching (visible) photos, not the whole gallery.
  // We intercept the click, build an array from the visible <a> items, and open
  // PhotoSwipe on that array directly. When no filter is active, this handler does
  // nothing and the normal DOM-based lightbox runs unchanged.
  const galleryRoot = document.querySelector('#gallery');
  if (galleryRoot) {
    galleryRoot.addEventListener('click', (e) => {
      const root = document.querySelector('#gallery');
      if (!root || !root.hasAttribute('data-filtered')) return; // no filter -> default behaviour

      const link = e.target.closest('a');
      if (!link) return;

      e.preventDefault();
      e.stopPropagation();

      // Only the currently visible (matching) items.
      const visible = Array.from(root.querySelectorAll('a')).filter(
        (a) => a.style.display !== 'none'
      );
      const startIndex = visible.indexOf(link);
      if (startIndex === -1) return;

      const dataSource = visible.map((a) => ({
        src: a.getAttribute('href'),
        width: parseInt(a.getAttribute('data-pswp-width'), 10) || undefined,
        height: parseInt(a.getAttribute('data-pswp-height'), 10) || undefined,
        alt: a.getAttribute('data-pswp-caption') || '',
        element: a,
      }));

      lightbox.loadAndOpen(startIndex, dataSource);
    }, true); // capture phase: run before PhotoSwipe's own click handler
  }

  // Deep-link: if URL has ?photo=<index>, open that photo directly.
  // Index matches the gallery's <a> order (same order as the search index).
  const params = new URLSearchParams(window.location.search);
  const photoParam = params.get('photo');
  if (photoParam !== null) {
    const idx = parseInt(photoParam, 10);
    const items = document.querySelectorAll('#gallery a');
    if (!isNaN(idx) && idx >= 0 && idx < items.length) {
      // Open once the gallery DOM is ready.
      requestAnimationFrame(() => lightbox.loadAndOpen(idx));
    }
    // Remove the param so refresh / back doesn't re-open the lightbox.
    params.delete('photo');
    const clean = window.location.pathname + (params.toString() ? '?' + params.toString() : '');
    window.history.replaceState({}, '', clean);
  }
</script>
