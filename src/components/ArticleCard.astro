---
interface Props {
  href: string;
  image: string;
  imageAlt?: string;
  category?: string;
  title: string;
  subtitle?: string;
  size?: 'lg' | 'md' | 'sm';
  textBelow?: boolean;
  focus?: 'top' | 'center' | 'bottom';
}

const {
  href,
  image,
  imageAlt,
  category,
  title,
  subtitle,
  size = 'md',
  textBelow = false,
  focus = 'center',
} = Astro.props;

// Category → CSS class for chip coloring (matches .chip--<key> in styles)
const categoryKey = category ? category.toLowerCase().replace(/[^a-z0-9]/g, '') : '';
---

<article class:list={['acard', `acard--${size}`, textBelow && 'acard--text-below']}>
  <a href={href} class="acard__link">
    <div class="acard__image-wrap">
      <img
        src={image}
        alt={imageAlt || title}
        class="acard__image"
        style={`object-position: ${focus}`}
        loading={size === 'lg' ? 'eager' : 'lazy'}
      />
      {!textBelow && <div class="acard__overlay"></div>}
      {category && <span class={`chip chip--${categoryKey}`}>{category}</span>}
      {!textBelow && (
        <div class="acard__text-wrap">
          <h3 class="acard__title">{title}</h3>
          {subtitle && (
            <p class="acard__subtitle">{subtitle}</p>
          )}
        </div>
      )}
    </div>
    {textBelow && (
      <div class="acard__below-text">
        <h3 class="acard__below-title">{title}</h3>
        {subtitle && (
          <p class="acard__below-subtitle">{subtitle}</p>
        )}
      </div>
    )}
  </a>
</article>

<style>
  .acard {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: #1a1a1a;
    transition: transform 0.2s ease;
    height: 100%;
  }

  .acard:hover {
    transform: translateY(-3px);
  }

  .acard__link {
    display: block;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  .acard__image-wrap {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  /* Aspect ratios per size — only apply when card can't fill parent */
  .acard--lg .acard__image-wrap { aspect-ratio: 4/3; }
  .acard--md .acard__image-wrap { aspect-ratio: 16/9; }
  .acard--sm .acard__image-wrap { aspect-ratio: 4/3; }

  /* When parent provides height (e.g. grid with fixed rows), fill it */
  .acard--fill .acard__image-wrap {
    aspect-ratio: auto;
    min-height: 100%;
  }

  .acard__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .acard:hover .acard__image {
    transform: scale(1.04);
  }

  .acard__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.1) 0%,
      rgba(0, 0, 0, 0.2) 45%,
      rgba(0, 0, 0, 0.85) 100%
    );
    pointer-events: none;
  }

  /* Category chip — top-left corner */
  .chip {
    position: absolute;
    top: 12px;
    left: 12px;
    font-family: var(--font-headline);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: white;
    background: #5F5E5A;
    padding: 5px 10px;
    border-radius: 3px;
    line-height: 1;
    z-index: 2;
  }

  /* Category color mapping.
     Chip text is small bold (~11.5px) so WCAG AA needs 4.5:1. With white text,
     mx2/speedway/enduro/technical/interview all fell below (3.4–3.9:1). Black
     text on these same bright backgrounds clears 4.5:1 (5.3–6.1:1) while keeping
     the vivid palette — matching how the mxgp chip already works. */
  .chip--mxgp     { background: #FF9900; color: #000; }
  .chip--mx2      { background: #D85A30; color: #000; }
  .chip--historical { background: #FF9900; color: #000; }
  .chip--speedway { background: #378ADD; color: #000; }
  .chip--enduro   { background: #639922; color: #000; }
  .chip--technical { background: #7F77DD; color: #000; }
  .chip--interview { background: #D4537E; color: #000; }

  /* Large card gets larger chip */
  .acard--lg .chip {
    top: 16px;
    left: 16px;
    font-size: 0.8rem;
    padding: 6px 12px;
  }

  /* Text overlay at bottom */
  .acard__text-wrap {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
    z-index: 2;
    color: white;
  }

  .acard--lg .acard__text-wrap {
    left: 20px;
    right: 20px;
    bottom: 20px;
  }

  .acard__title {
    font-family: var(--font-headline);
    font-weight: 900;
    color: white;
    margin: 0;
    line-height: 1.15;
    text-shadow: 0 1px 4px rgba(0,0,0,0.6);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .acard--lg .acard__title {
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    -webkit-line-clamp: 3;
  }
  .acard--md .acard__title {
    font-size: 1.2rem;
    line-height: 1.2;
  }
  .acard--sm .acard__title {
    font-size: 0.95rem;
    line-height: 1.2;
  }

  .acard__subtitle {
    font-family: var(--font-body);
    margin: 8px 0 0;
    font-size: 1rem;
    font-weight: 500;
    color: rgba(255,255,255,0.92);
    text-shadow: 0 1px 3px rgba(0,0,0,0.5);
    line-height: 1.35;
  }

  /* ===== textBelow variant: title/subtitle in normal flow below the image
     instead of overlaid on the photo. Image keeps a fixed 16:9 ratio (matches
     .acard--md) so a portrait or landscape source crops/centers to the same
     uniform height instead of driving the whole card's height. ===== */
  .acard--text-below {
    background: transparent;
  }

  .acard--text-below .acard__link {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .acard--text-below .acard__image-wrap {
    aspect-ratio: 16/9;
    height: auto;
  }

  .acard__below-text {
    flex: 0 0 auto;
    padding: var(--space-3);
  }

  .acard__below-title {
    font-family: var(--font-headline);
    font-weight: 900;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.2;
    font-size: clamp(1.4rem, 2.4vw, 2rem);
  }

  .acard__below-subtitle {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-secondary);
    margin: 8px 0 0;
    line-height: 1.35;
  }

  @media (max-width: 768px) {
    .acard__title { font-size: 1rem; }
    .acard--lg .acard__title { font-size: 1.3rem; }
    .acard--lg .acard__subtitle { font-size: 0.9rem; }
    .acard__below-title { font-size: 1.3rem; }
    .acard__below-subtitle { font-size: 0.9rem; }
  }
</style>
