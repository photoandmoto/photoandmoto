---
import { ui } from '../i18n/ui';
import LanguageSwitcher from './LanguageSwitcher.astro';
import HeaderClock from './HeaderClock.astro';
import TrendingTicker from './TrendingTicker.astro';
import type { TickerItem } from '../lib/tickerItems';

interface Props {
  lang: 'fi' | 'en';
  currentPath: string;
  showTicker?: boolean;
  tickerItems?: TickerItem[];
}

const { lang, currentPath, showTicker = false, tickerItems = [] } = Astro.props;
const t = ui[lang];
const tickerLabel = lang === 'fi' ? 'Nyt luetuimmat' : 'Trending now';

const navItems = lang === 'fi'
  ? [
      { href: '/fi', label: t['nav.home'] },
      { href: '/fi/pikauutiset', label: t['nav.inBrief'] },
      { href: '/fi/galleria', label: t['nav.gallery'] },
      { href: '/fi/aikakone', label: t['nav.articles'] },
    ]
  : [
      { href: '/en', label: t['nav.home'] },
      { href: '/en/in-brief', label: t['nav.inBrief'] },
      { href: '/en/gallery', label: t['nav.gallery'] },
      { href: '/en/time-machine', label: t['nav.articles'] },
    ];

const contactItem = lang === 'fi'
  ? { href: '/fi/yhteystiedot', label: t['nav.contact'] }
  : { href: '/en/yhteystiedot', label: t['nav.contact'] };

const moreItems = lang === 'fi'
  ? [
      { href: '/fi/mxgp-2026', label: 'MXGP 2026' },
      { href: '/fi/tilastot', label: 'Tilastot' },
      { href: '/fi/kalenteri', label: 'Kalenteri' },
      { href: '/fi/haku', label: 'AI-haku' },
      { href: '/fi/podcast', label: 'Podcast' },
      { href: '/fi/tunnistamatta', label: 'Tunnista kuva' },
      { href: '/fi/toimitus', label: 'Toimituskeskus' },
    ]
  : [
      { href: '/en/mxgp-2026', label: 'MXGP 2026' },
      { href: '/en/identify', label: 'Identify Photo' },
    ];

const showMore = moreItems.length > 0;

const moreLabel = lang === 'fi' ? 'Muuta' : 'More';
const isMoreActive = moreItems.some(item => currentPath.startsWith(item.href));

// Search page link
const searchHref = lang === 'fi' ? '/fi/etsi' : '/en/search';
const searchLabel = lang === 'fi' ? 'Etsi' : 'Search';

// Flat list for mobile menu (in visual order: main + more + search + contact)
const mobileFlatItems = [
  ...navItems,
  ...moreItems,
  { href: searchHref, label: searchLabel },
  contactItem,
];
---

<header class="site-header">

  <!-- BAND 1: logo row -->
  <div class="header-logo-row">
    <div class="container logo-row-inner">
      <a href={`/${lang}`} class="logo" aria-label="Photo & Moto home"
         data-no-newtab>
        <span class="logo-text">Photo &amp; Moto</span>
      </a>
      {showTicker && <HeaderClock lang={lang} />}
    </div>
  </div>

  <!-- BAND 2: nav row — sticks to the top of the viewport while the logo row
       and ticker scroll away. -->
  <div class:list={['header-nav-row', { 'header-nav-row--flush': showTicker }]} id="headerNavRow">
    <div class="container nav-row-inner">

      <!-- Small wordmark, shown only once the big logo has scrolled out of
           view (toggled by the IntersectionObserver below). visibility:hidden
           while collapsed keeps it out of the tab order and a11y tree. -->
      <a href={`/${lang}`} class="nav-wordmark" aria-label="Photo & Moto home"
         data-no-newtab>Photo &amp; Moto</a>

      <!-- Desktop nav — exactly as before -->
      <nav class="main-nav desktop-nav">
        <ul>
          {navItems.map(item => (
            <li>
              <a
                href={item.href}
                data-no-newtab
                class:list={['nav-link', { active: currentPath === item.href || (item.href !== `/${lang}` && currentPath.startsWith(item.href)) }]}
              >
                {item.label}
              </a>
            </li>
          ))}
          {showMore && (
            <li class="nav-dropdown">
              <button class:list={['nav-link', 'nav-drop-btn', { active: isMoreActive }]}>
                {moreLabel} <span class="drop-arrow">▾</span>
              </button>
              <div class="nav-drop-menu">
                {moreItems.map(item => (
                  <a href={item.href} data-no-newtab
                     class:list={['nav-drop-item', { active: currentPath.startsWith(item.href) }]}>
                    {item.label}
                  </a>
                ))}
              </div>
            </li>
          )}
          <li>
            <a
              href={contactItem.href}
              data-no-newtab
              class:list={['nav-link', { active: currentPath === contactItem.href || currentPath.startsWith(contactItem.href) }]}
            >
              {contactItem.label}
            </a>
          </li>
        </ul>
      </nav>

      <!-- Right side: hamburger, then a search+language group. Hamburger is
           first in DOM order and, on mobile, .header-right's
           justify-content: space-between pushes it to the far left and the
           .header-utility group (search + language) to the far right --
           mirroring desktop's right-aligned search/language pair. Hamburger
           stays display:none on desktop, so none of this affects desktop's
           layout there. -->
      <div class="header-right">
        <button class="hamburger" id="hamburgerBtn"
                aria-label="Toggle menu" aria-expanded="false"
                aria-controls="mobileNav">
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
        </button>
        <div class="header-utility">
          <a
            href={searchHref}
            class:list={['search-icon-link', { active: currentPath.startsWith(searchHref) }]}
            target="_blank"
            rel="noopener"
            aria-label={searchLabel}
            title={searchLabel}
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                 viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"
                 aria-hidden="true">
              <circle cx="11" cy="11" r="7" />
              <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
          </a>
          <LanguageSwitcher lang={lang} currentPath={currentPath} />
        </div>
      </div>

    </div>

    <!-- Mobile nav panel — inside the sticky nav row so it always opens
         directly below the bar, at any scroll position. -->
    <nav class="mobile-nav" id="mobileNav" aria-hidden="true">
      <ul>
        {mobileFlatItems.map(item => (
          <li>
            <a
              href={item.href}
              data-no-newtab
              class:list={['mobile-nav-link', { active: currentPath === item.href || (item.href !== `/${lang}` && currentPath.startsWith(item.href)) }]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <!-- BAND 3: ticker strip — flush against the nav row above (see
       .header-nav-row--flush). Site-wide "most read" pool, identical on
       every page (computed once per lang in BaseLayout). -->
  {showTicker && tickerItems.length > 0 && (
    <div class="ticker-band">
      <TrendingTicker label={tickerLabel} items={tickerItems} intervalMs={3000} />
    </div>
  )}

</header>

<script>
  // Desktop dropdown (Muuta)
  const dropdown = document.querySelector('.nav-dropdown');
  if (dropdown) {
    const btn = dropdown.querySelector('.nav-drop-btn');
    const menu = dropdown.querySelector('.nav-drop-menu');

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      menu.classList.toggle('nav-drop-open');
    });

    document.addEventListener('click', () => {
      menu.classList.remove('nav-drop-open');
    });
  }

  // Sticky nav wordmark: shown once the big logo row is fully out of view.
  const logoRow = document.querySelector('.header-logo-row');
  const navRow = document.getElementById('headerNavRow');
  if (logoRow && navRow && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      navRow.classList.toggle('is-stuck', !entry.isIntersecting);
    }).observe(logoRow);
  }

  // Mobile hamburger
  const hamburgerBtn = document.getElementById('hamburgerBtn');
  const mobileNav = document.getElementById('mobileNav');
  if (hamburgerBtn && mobileNav) {
    hamburgerBtn.addEventListener('click', () => {
      const isOpen = hamburgerBtn.classList.toggle('hamburger-open');
      mobileNav.classList.toggle('mobile-nav-open', isOpen);
      hamburgerBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      mobileNav.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
      document.body.style.overflow = isOpen ? 'hidden' : '';
    });

    // Close menu when a link is clicked
    mobileNav.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        hamburgerBtn.classList.remove('hamburger-open');
        mobileNav.classList.remove('mobile-nav-open');
        hamburgerBtn.setAttribute('aria-expanded', 'false');
        mobileNav.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      });
    });
  }
</script>

<style>
  /* ── Site header shell ─────────────────────────────────────────── */
  /* `display: contents` removes the <header>'s own box so the three bands lay
     out as plain flow children of <body>. */
  .site-header {
    display: contents;
  }

  /* ── BAND 1: logo row ──────────────────────────────────────────── */
  /* Padding is deliberately symmetric. It used to be 22px top / 0 bottom, which
     pressed the wordmark straight onto the nav bar and made the masthead read as
     cramped rather than confident — the band was not too short, it was
     unbalanced. Costs ~46px of above-the-fold space on every page. */
  .header-logo-row {
    background: #000;
    padding: 44px 0 20px;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  .logo-row-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    row-gap: 4px;
  }

  .logo {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
  }

  .logo-text {
    font-family: var(--font-headline);
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 900;
    color: var(--brand-primary);
    letter-spacing: 0.5px;
    line-height: 1;
    text-transform: uppercase;
  }

  /* ── BAND 2: nav row ───────────────────────────────────────────── */
  /* Sticky for the whole page: .site-header is display:contents, so this
     row's containing block is <body>. z-index sits above page content but
     below the photo viewers (1000+) and the cookie banner (9000+). */
  .header-nav-row {
    position: sticky;
    top: 0;
    z-index: 500;
    background: #000;
    border-top: 1px solid rgba(255,255,255,0.08);
    border-bottom: 2px solid var(--brand-primary);
  }

  /* When the ticker sits directly below the nav (every page that shows
     one), drop the orange accent border so nav+ticker reads as one solid
     black block instead of being split by a colored seam. Pages that
     opt out of the ticker keep the orange border as-is. */
  .header-nav-row--flush {
    border-bottom: none;
  }

  .nav-row-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 46px;
    padding-top: 0;
    padding-bottom: 0;
    gap: var(--space-3);
  }

  /* ── Sticky wordmark ───────────────────────────────────────────── */
  /* Always takes up its width, so the nav links never move; only fades in
     once .is-stuck is set. visibility:hidden while faded out keeps it out
     of the tab order and a11y tree. */
  .nav-wordmark {
    flex: none;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    font-family: var(--font-headline);
    font-size: 18px;
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--brand-primary);
    text-decoration: none;
    transition: opacity 0.2s ease, visibility 0s linear 0.2s;
  }

  .is-stuck .nav-wordmark {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.2s ease, visibility 0s linear 0s;
  }

  /* Desktop menu below 1280px has no room for the wordmark's reserved
     space (FI row needs 1252px with it), so it is left out there; the bar
     still sticks. */
  @media (min-width: 1000px) and (max-width: 1279px) {
    .nav-wordmark { display: none; }
  }

  /* ── Nav links (unchanged from original) ──────────────────────── */
  /* Auto margin keeps the links packed left (after the wordmark) rather
     than centred by the row's space-between. */
  .desktop-nav { margin-right: auto; }

  /* Fluid gap: 32px at >= 1280px (unchanged look), shrinking linearly to
     8px at 960px. Measured FI row (the wider language): 692px of links +
     5 gaps + 216px (search, FI/EN, row gap, container padding) -> 948px at
     the 8px minimum, which is why the desktop menu starts at 1000px (room
     for a 17px scrollbar plus margin). */
  .main-nav ul {
    display: flex;
    gap: clamp(8px, 7.5vw - 64px, 32px);
    list-style: none;
    margin: 0;
    padding: 0;
    align-items: center;
  }

  .nav-link {
    font-family: var(--font-headline);
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: white;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
    text-decoration: none;
  }

  .nav-link:hover,
  .nav-link.active {
    background: var(--brand-primary);
    color: black;
  }

  .search-icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    color: white;
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
    text-decoration: none;
  }

  .search-icon-link:hover,
  .search-icon-link.active {
    background: var(--brand-primary);
    color: black;
  }

  /* ── Dropdown (unchanged) ──────────────────────────────────────── */
  .nav-dropdown { position: relative; }

  .nav-drop-btn {
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .drop-arrow { font-size: 0.7rem; }

  .nav-drop-menu {
    display: none;
    position: absolute;
    top: 100%;
    right: 0;
    margin-top: 8px;
    background: #1a1a1a;
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: var(--radius-md);
    min-width: 180px;
    padding: 6px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.4);
    z-index: 100;
  }

  .nav-drop-open { display: flex; flex-direction: column; }

  .nav-drop-item {
    font-family: var(--font-headline);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: white;
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .nav-drop-item:hover { background: var(--brand-primary); color: black; }
  .nav-drop-item.active { color: var(--brand-primary); }

  /* ── Header right (hamburger + search/lang group) ───────────────── */
  .header-right {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .header-utility {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* ── BAND 3: ticker strip ──────────────────────────────────────── */
  /* Flush against the nav row above (border removed via
     .header-nav-row--flush); spacing is kept only below, before the
     page's own content starts. */
  .ticker-band {
    margin: 0 0 var(--space-3);
  }

  /* ── Hamburger (mobile only) ───────────────────────────────────── */
  .hamburger {
    display: none;
    background: none;
    border: none;
    width: 44px;
    height: 44px;
    padding: 10px;
    cursor: pointer;
    flex-direction: column;
    justify-content: space-between;
    align-items: stretch;
  }

  .hamburger-bar {
    display: block;
    width: 100%;
    height: 3px;
    background: white;
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
    transform-origin: center;
  }

  .hamburger-open .hamburger-bar:nth-child(1) { transform: translateY(10px) rotate(45deg); }
  .hamburger-open .hamburger-bar:nth-child(2) { opacity: 0; }
  .hamburger-open .hamburger-bar:nth-child(3) { transform: translateY(-10px) rotate(-45deg); }

  /* ── Mobile nav panel ──────────────────────────────────────────── */
  .mobile-nav { display: none; }

  /* ── Menu-button breakpoint ────────────────────────────────────── */
  /* Below 1000px the desktop links don't fit even at the 8px minimum gap
     (see .main-nav ul), so the bar switches to the menu button. Keep in
     sync with --sticky-nav-h in global.css. */
  @media (max-width: 999px) {
    .desktop-nav { display: none; }
    .hamburger { display: flex; }

    /* Slim sticky bar: hamburger, then the wordmark once the logo has
       scrolled away, with search + language pushed to the far right.
       .header-right dissolves so its children line up with the wordmark. */
    .nav-row-inner {
      min-height: var(--sticky-nav-h);
      gap: var(--space-1);
    }

    .header-right { display: contents; }
    /* flex: none so the reserved wordmark space can never squeeze the
       menu button; row = 44 + wordmark + search/lang must fit 358px at 390. */
    .hamburger { order: -1; flex: none; }
    .header-utility { margin-left: auto; gap: var(--space-1); }
    .nav-wordmark { font-size: 16px; }

    .mobile-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      display: block;
      max-height: 0;
      overflow: hidden;
      visibility: hidden;
      background: #000;
      border-top: 1px solid rgba(255,255,255,0.1);
      transition: max-height 0.3s ease, visibility 0s linear 0.3s;
    }

    .mobile-nav.mobile-nav-open {
      max-height: calc(100vh - var(--sticky-nav-h));
      overflow-y: auto;
      visibility: visible;
      transition: max-height 0.3s ease, visibility 0s linear 0s;
    }

    .mobile-nav ul {
      list-style: none;
      margin: 0;
      padding: var(--space-2) 0;
      display: flex;
      flex-direction: column;
    }

    .mobile-nav-link {
      display: block;
      font-family: var(--font-headline);
      font-size: 1rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: white;
      padding: 16px var(--space-4);
      text-decoration: none;
      border-bottom: 1px solid rgba(255,255,255,0.06);
      transition: background 0.15s, color 0.15s;
    }

    .mobile-nav-link:last-child { border-bottom: none; }

    .mobile-nav-link:hover,
    .mobile-nav-link:focus { background: rgba(255,153,0,0.1); }

    .mobile-nav-link.active { background: var(--brand-primary); color: black; }
  }

  /* ── Mobile logo row ───────────────────────────────────────────── */
  @media (max-width: 768px) {
    .logo-text { font-size: 1.8rem; }

    .header-logo-row {
      padding: 28px 0 14px;
    }
  }

  @media (max-width: 480px) {
    .logo-text { font-size: 1.4rem; }
  }

  @media (max-width: 374px) {
    .nav-wordmark { font-size: 14px; }
  }

  /* Below 360px menu button + wordmark + search + FI/EN no longer fit
     (FI/EN was cut by 12px at 320px), so the wordmark is left out. */
  @media (max-width: 359px) {
    .nav-wordmark { display: none; }
  }
</style>
