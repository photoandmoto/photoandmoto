---
import { ui } from '../i18n/ui';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang: 'fi' | 'en';
  currentPath: string;
}

const { lang, currentPath } = Astro.props;
const t = ui[lang];

const socialFacebook  = t['social.facebook'];
const socialYoutube   = t['social.youtube'];
const socialInstagram = t['social.instagram'];

const navItems = lang === 'fi'
  ? [
      { href: '/fi', label: t['nav.home'] },
      { href: '/fi/galleria', label: t['nav.gallery'] },
      { href: '/fi/aikakone', label: t['nav.articles'] },
    ]
  : [
      { href: '/en', label: t['nav.home'] },
      { href: '/en/gallery', label: t['nav.gallery'] },
      { href: '/en/time-machine', label: t['nav.articles'] },
    ];

const contactItem = lang === 'fi'
  ? { href: '/fi/yhteystiedot', label: t['nav.contact'] }
  : { href: '/en/yhteystiedot', label: t['nav.contact'] };

const moreItems = lang === 'fi'
  ? [
      { href: '/fi/mxgp-2026', label: 'MXGP 2026' },
      { href: '/fi/tilastot', label: 'Tilastot' },
      { href: '/fi/kalenteri', label: 'Kalenteri' },
      { href: '/fi/haku', label: 'AI-haku' },
      { href: '/fi/podcast', label: 'Podcast' },
      { href: '/fi/tunnistamatta', label: 'Tunnista kuva' },
      { href: '/fi/yllapito', label: 'Ylläpito' },
    ]
  : [
      { href: '/en/mxgp-2026', label: 'MXGP 2026' },
      { href: '/en/identify', label: 'Identify Photo' },
    ];

const showMore = moreItems.length > 0;

const moreLabel = lang === 'fi' ? 'Muuta' : 'More';
const isMoreActive = moreItems.some(item => currentPath.startsWith(item.href));

// Search page link
const searchHref = lang === 'fi' ? '/fi/etsi' : '/en/search';
const searchLabel = lang === 'fi' ? 'Etsi' : 'Search';

// Flat list for mobile menu (in visual order: main + more + search + contact)
const mobileFlatItems = [
  ...navItems,
  ...moreItems,
  { href: searchHref, label: searchLabel },
  contactItem,
];
---

<header class="site-header">

  <!-- BAND 1: sticky ticker strip + social icons -->
  <div class="header-ticker-strip">
    <div class="container ticker-strip-inner">
      <div class="ticker-slot">
        <slot name="ticker" />
      </div>
      <div class="social-icons">
        <a href={socialFacebook} target="_blank" rel="noopener"
           aria-label="Facebook" class="social-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
          </svg>
        </a>
        <a href={socialYoutube} target="_blank" rel="noopener"
           aria-label="YouTube" class="social-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.95 1.96C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.96-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58zM9.75 15.02V8.98L15.5 12l-5.75 3.02z"/>
          </svg>
        </a>
        <a href={socialInstagram} target="_blank" rel="noopener"
           aria-label="Instagram" class="social-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <circle cx="12" cy="12" r="4"/>
            <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- BAND 2: sticky logo row -->
  <div class="header-logo-row">
    <div class="container">
      <a href={`/${lang}`} class="logo" aria-label="Photo & Moto home"
         data-no-newtab>
        <span class="logo-text">Photo &amp; Moto</span>
      </a>
    </div>
  </div>

  <!-- BAND 3: scrolling nav row -->
  <div class="header-nav-row">
    <div class="container nav-row-inner">

      <!-- Desktop nav — exactly as before -->
      <nav class="main-nav desktop-nav">
        <ul>
          {navItems.map(item => (
            <li>
              <a
                href={item.href}
                data-no-newtab
                class:list={['nav-link', { active: currentPath === item.href || (item.href !== `/${lang}` && currentPath.startsWith(item.href)) }]}
              >
                {item.label}
              </a>
            </li>
          ))}
          {showMore && (
            <li class="nav-dropdown">
              <button class:list={['nav-link', 'nav-drop-btn', { active: isMoreActive }]}>
                {moreLabel} <span class="drop-arrow">▾</span>
              </button>
              <div class="nav-drop-menu">
                {moreItems.map(item => (
                  <a href={item.href} data-no-newtab
                     class:list={['nav-drop-item', { active: currentPath.startsWith(item.href) }]}>
                    {item.label}
                  </a>
                ))}
              </div>
            </li>
          )}
          <li>
            <a
              href={contactItem.href}
              data-no-newtab
              class:list={['nav-link', { active: currentPath === contactItem.href || currentPath.startsWith(contactItem.href) }]}
            >
              {contactItem.label}
            </a>
          </li>
        </ul>
      </nav>

      <!-- Right side: search + language + hamburger -->
      <div class="header-right">
        <a
          href={searchHref}
          class:list={['search-icon-link', { active: currentPath.startsWith(searchHref) }]}
          target="_blank"
          rel="noopener"
          aria-label={searchLabel}
          title={searchLabel}
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
               viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"
               aria-hidden="true">
            <circle cx="11" cy="11" r="7" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
        </a>
        <LanguageSwitcher lang={lang} currentPath={currentPath} />
        <button class="hamburger" id="hamburgerBtn"
                aria-label="Toggle menu" aria-expanded="false"
                aria-controls="mobileNav">
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile nav panel — exactly as before -->
  <nav class="mobile-nav" id="mobileNav" aria-hidden="true">
    <ul>
      {mobileFlatItems.map(item => (
        <li>
          <a
            href={item.href}
            data-no-newtab
            class:list={['mobile-nav-link', { active: currentPath === item.href || (item.href !== `/${lang}` && currentPath.startsWith(item.href)) }]}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

</header>

<script>
  // Desktop dropdown (Muuta)
  const dropdown = document.querySelector('.nav-dropdown');
  if (dropdown) {
    const btn = dropdown.querySelector('.nav-drop-btn');
    const menu = dropdown.querySelector('.nav-drop-menu');

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      menu.classList.toggle('nav-drop-open');
    });

    document.addEventListener('click', () => {
      menu.classList.remove('nav-drop-open');
    });
  }

  // Mobile hamburger
  const hamburgerBtn = document.getElementById('hamburgerBtn');
  const mobileNav = document.getElementById('mobileNav');
  if (hamburgerBtn && mobileNav) {
    hamburgerBtn.addEventListener('click', () => {
      const isOpen = hamburgerBtn.classList.toggle('hamburger-open');
      mobileNav.classList.toggle('mobile-nav-open', isOpen);
      hamburgerBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      mobileNav.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
      document.body.style.overflow = isOpen ? 'hidden' : '';
    });

    // Close menu when a link is clicked
    mobileNav.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        hamburgerBtn.classList.remove('hamburger-open');
        mobileNav.classList.remove('mobile-nav-open');
        hamburgerBtn.setAttribute('aria-expanded', 'false');
        mobileNav.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      });
    });
  }
</script>

<style>
  /* ── Site header shell ─────────────────────────────────────────── */
  /* `display: contents` removes the <header>'s own box from the layout so the
     three bands become flow children of <body>. Their sticky containing block
     is then the full page height — without this, sticky only holds while the
     short .site-header box is in view, so the bands scroll away immediately. */
  .site-header {
    display: contents;
    /* Shared height of BAND 1; BAND 2 sticks at this offset. Defined here so
       both bands (DOM children of .site-header) inherit it — custom properties
       still inherit through a `display: contents` element. */
    --ticker-h: 44px;
  }

  /* ── BAND 1: sticky ticker strip ──────────────────────────────── */
  /* Fixed height so BAND 2's sticky `top` offset (var(--ticker-h)) lands
     flush against this strip's bottom edge — no gap, no overlap — at every
     breakpoint. The TrendingTicker content (~42px) fits inside this height. */
  .header-ticker-strip {
    position: sticky;
    top: 0;
    z-index: 1000;
    height: var(--ticker-h);
    background: #0a0a0a;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }

  .ticker-strip-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    padding-top: 0;
    padding-bottom: 0;
    gap: 16px;
  }

  .ticker-slot {
    flex: 1;
    min-width: 0;
    /* TrendingTicker renders its own .ticker wrapper inside here.
       Override its background/border so it blends into band 1. */
  }

  /* TrendingTicker renders a .ticker div — strip its own bg and border
     since band 1 provides the background. */
  .ticker-slot :global(.ticker) {
    background: transparent;
    border-bottom: none;
  }

  .social-icons {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-shrink: 0;
  }

  .social-icon {
    color: rgba(255,255,255,0.55);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: color var(--transition-fast);
    text-decoration: none;
    line-height: 1;
  }

  .social-icon:hover {
    color: var(--brand-primary);
  }

  /* ── BAND 2: sticky logo row ───────────────────────────────────── */
  .header-logo-row {
    position: sticky;
    top: var(--ticker-h); /* flush below band 1 */
    z-index: 999;
    background: #000;
    padding: 14px 0 10px;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  .logo {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
  }

  .logo-text {
    font-family: var(--font-headline);
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 900;
    color: var(--brand-primary);
    letter-spacing: 0.5px;
    line-height: 1;
    text-transform: uppercase;
  }

  /* ── BAND 3: scrolling nav row ─────────────────────────────────── */
  .header-nav-row {
    background: #000;
    border-top: 1px solid rgba(255,255,255,0.08);
    border-bottom: 2px solid var(--brand-primary);
    /* NOT sticky — scrolls away with the page */
  }

  .nav-row-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 46px;
    padding-top: 0;
    padding-bottom: 0;
    gap: var(--space-3);
  }

  /* ── Nav links (unchanged from original) ──────────────────────── */
  .main-nav ul {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
    align-items: center;
  }

  .nav-link {
    font-family: var(--font-headline);
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: white;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
    text-decoration: none;
  }

  .nav-link:hover,
  .nav-link.active {
    background: var(--brand-primary);
    color: black;
  }

  .search-icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    color: white;
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
    text-decoration: none;
  }

  .search-icon-link:hover,
  .search-icon-link.active {
    background: var(--brand-primary);
    color: black;
  }

  /* ── Dropdown (unchanged) ──────────────────────────────────────── */
  .nav-dropdown { position: relative; }

  .nav-drop-btn {
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .drop-arrow { font-size: 0.7rem; }

  .nav-drop-menu {
    display: none;
    position: absolute;
    top: 100%;
    right: 0;
    margin-top: 8px;
    background: #1a1a1a;
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: var(--radius-md);
    min-width: 180px;
    padding: 6px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.4);
    z-index: 100;
  }

  .nav-drop-open { display: flex; flex-direction: column; }

  .nav-drop-item {
    font-family: var(--font-headline);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: white;
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .nav-drop-item:hover { background: var(--brand-primary); color: black; }
  .nav-drop-item.active { color: var(--brand-primary); }

  /* ── Header right (search + lang + hamburger) ──────────────────── */
  .header-right {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* ── Hamburger (mobile only) ───────────────────────────────────── */
  .hamburger {
    display: none;
    background: none;
    border: none;
    width: 44px;
    height: 44px;
    padding: 10px;
    cursor: pointer;
    flex-direction: column;
    justify-content: space-between;
    align-items: stretch;
  }

  .hamburger-bar {
    display: block;
    width: 100%;
    height: 3px;
    background: white;
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
    transform-origin: center;
  }

  .hamburger-open .hamburger-bar:nth-child(1) { transform: translateY(10px) rotate(45deg); }
  .hamburger-open .hamburger-bar:nth-child(2) { opacity: 0; }
  .hamburger-open .hamburger-bar:nth-child(3) { transform: translateY(-10px) rotate(-45deg); }

  /* ── Mobile nav panel ──────────────────────────────────────────── */
  .mobile-nav { display: none; }

  /* ── Mobile breakpoint ─────────────────────────────────────────── */
  @media (max-width: 768px) {
    .desktop-nav { display: none; }
    .hamburger { display: flex; }

    .logo-text { font-size: 1.8rem; }

    .header-logo-row {
      /* top stays var(--ticker-h) — band 1 height is fixed across breakpoints */
      padding: 10px 0 8px;
    }

    .mobile-nav {
      display: block;
      max-height: 0;
      overflow: hidden;
      visibility: hidden;
      background: #000;
      border-top: 1px solid rgba(255,255,255,0.1);
      transition: max-height 0.3s ease, visibility 0s linear 0.3s;
    }

    .mobile-nav.mobile-nav-open {
      max-height: calc(100vh - 80px);
      overflow-y: auto;
      visibility: visible;
      transition: max-height 0.3s ease, visibility 0s linear 0s;
    }

    .mobile-nav ul {
      list-style: none;
      margin: 0;
      padding: var(--space-2) 0;
      display: flex;
      flex-direction: column;
    }

    .mobile-nav-link {
      display: block;
      font-family: var(--font-headline);
      font-size: 1rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: white;
      padding: 16px var(--space-4);
      text-decoration: none;
      border-bottom: 1px solid rgba(255,255,255,0.06);
      transition: background 0.15s, color 0.15s;
    }

    .mobile-nav-link:last-child { border-bottom: none; }

    .mobile-nav-link:hover,
    .mobile-nav-link:focus { background: rgba(255,153,0,0.1); }

    .mobile-nav-link.active { background: var(--brand-primary); color: black; }

    .social-icons { gap: 10px; }
  }

  @media (max-width: 480px) {
    .logo-text { font-size: 1.4rem; }
  }
</style>
