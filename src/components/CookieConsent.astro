---
/**
 * Cookie consent banner + settings modal.
 *
 * Behavior:
 *   - First visit (no localStorage record) → banner shows at the bottom
 *   - User picks Accept all / Essential only. Two buttons only: analytics is
 *     the sole optional category, so a third "Settings" button on the first
 *     prompt was noise for a single toggle.
 *   - Changing your mind later: the footer "Evästeasetukset" link opens the
 *     modal (any element with data-pm-cookie-open triggers it)
 *   - The modal can be dismissed without saving: X, Esc, or backdrop click
 *   - Choice persists in localStorage (key: pm_cookie_consent)
 *
 * What gets gated:
 *   - GA4 (sets _ga, _ga_* cookies). Loaded only when consent.analytics = true.
 *     Withdrawing consent sets GA's ga-disable flag, clears _ga/_ga_* and
 *     reloads — without that, an already-loaded gtag keeps sending for the
 *     rest of the session and the opt-out would be cosmetic.
 *
 * What does NOT need gating:
 *   - Cloudflare Web Analytics: cookieless by design, no consent required.
 *     Mentioned in the modal for transparency.
 *
 * Storage shape (localStorage, NOT a cookie — metadata about the decision):
 *   { version: 1, decided_at: ISO8601, analytics: boolean }
 */
interface Props {
  lang: 'fi' | 'en';
}

const { lang } = Astro.props;

const strings = {
  fi: {
    banner_title: 'Tämä sivusto käyttää evästeitä',
    banner_text: 'Käytämme Google Analyticsia ymmärtääksemme miten sivustoa käytetään. Voit hyväksyä sen tai käyttää sivustoa vain välttämättömillä. Voit muuttaa valintaasi myöhemmin alatunnisteen Evästeasetukset-linkistä.',
    accept_all: 'Hyväksy kaikki',
    essential_only: 'Vain välttämättömät',
    close: 'Sulje',
    modal_title: 'Evästeasetukset',
    modal_intro: 'Voit valita itse mitä evästeitä sallit. Välttämättömät ovat aina käytössä, koska sivusto ei toimi ilman niitä.',
    cat_essential_title: 'Välttämättömät',
    cat_essential_desc: 'Kirjautumisistunto (pm_session) vain sivuston ylläpitäjille — tavallinen kävijä ei saa tätä evästettä. Evästevalintasi tallennetaan selaimen local storageen, ei evästeeseen, ja kielivalinta on osa osoitetta. Käytännössä sivusto ei aseta kirjautumattomalle kävijälle yhtään evästettä.',
    cat_analytics_title: 'Analytiikka (Google Analytics)',
    cat_analytics_desc: 'Google Analytics 4 -seuranta auttaa meitä ymmärtämään mitä sisältöä lukijat etsivät ja kuinka pitkään he viipyvät sivuilla. Asettaa _ga ja _ga_* -evästeet.',
    cat_analytics_note: 'Lisäksi käytössä on Cloudflare Web Analytics, joka on evästeetön eikä vaadi suostumusta. Se kerää vain anonyymejä sivulatauksia.',
    save: 'Tallenna valinnat',
    privacy_link: 'Lue tietosuojaseloste',
  },
  en: {
    banner_title: 'This site uses cookies',
    banner_text: 'We use Google Analytics to understand how the site is used. You can accept it, or browse with essential cookies only. You can change your choice later via the Cookie settings link in the footer.',
    accept_all: 'Accept all',
    essential_only: 'Essential only',
    close: 'Close',
    modal_title: 'Cookie settings',
    modal_intro: 'Choose which cookies you allow. Essential cookies are always on because the site cannot function without them.',
    cat_essential_title: 'Essential',
    cat_essential_desc: 'A login session cookie (pm_session) for site administrators only — ordinary visitors never receive it. Your cookie choice is kept in browser local storage rather than a cookie, and language is part of the URL. In practice the site sets no cookies at all for a visitor who is not logged in.',
    cat_analytics_title: 'Analytics (Google Analytics)',
    cat_analytics_desc: 'Google Analytics 4 helps us understand what content readers look for and how long they stay. Sets _ga and _ga_* cookies.',
    cat_analytics_note: 'We also use Cloudflare Web Analytics, which is cookieless and requires no consent. It collects only anonymous page views.',
    save: 'Save choices',
    privacy_link: 'Read privacy policy',
  },
};

const t = strings[lang];
const privacyHref = lang === 'fi' ? '/fi/tietosuojaseloste/' : '/en/privacy-policy/';
---

<div id="pm-cookie-banner" class="pm-cookie-banner" hidden>
  <div class="pm-cookie-banner__inner">
    <p class="pm-cookie-banner__text">
      <strong>{t.banner_title}.</strong> {t.banner_text}
    </p>
    <div class="pm-cookie-banner__actions">
      <button type="button" id="pm-cookie-accept-all" class="pm-cookie-btn pm-cookie-btn--primary">
        {t.accept_all}
      </button>
      <button type="button" id="pm-cookie-essential" class="pm-cookie-btn pm-cookie-btn--primary">
        {t.essential_only}
      </button>
    </div>
  </div>
</div>

<div id="pm-cookie-modal" class="pm-cookie-modal" hidden>
  <div class="pm-cookie-modal__panel">
    <button type="button" id="pm-cookie-close" class="pm-cookie-modal__close" aria-label={t.close}>&times;</button>
    <h2 class="pm-cookie-modal__title">{t.modal_title}</h2>
    <p class="pm-cookie-modal__intro">{t.modal_intro}</p>

    <div class="pm-cookie-cat">
      <label class="pm-cookie-cat__head">
        <input type="checkbox" checked disabled />
        <strong>{t.cat_essential_title}</strong>
      </label>
      <p class="pm-cookie-cat__desc">{t.cat_essential_desc}</p>
    </div>

    <div class="pm-cookie-cat">
      <label class="pm-cookie-cat__head">
        <input type="checkbox" id="pm-cookie-toggle-analytics" />
        <strong>{t.cat_analytics_title}</strong>
      </label>
      <p class="pm-cookie-cat__desc">{t.cat_analytics_desc}</p>
      <p class="pm-cookie-cat__note">{t.cat_analytics_note}</p>
    </div>

    <div class="pm-cookie-modal__actions">
      <a href={privacyHref} class="pm-cookie-modal__privacy" data-no-newtab>{t.privacy_link}</a>
      <button type="button" id="pm-cookie-save" class="pm-cookie-btn pm-cookie-btn--primary">
        {t.save}
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = 'pm_cookie_consent';
    var VERSION = 1;
    var GA_ID = 'G-9Y0PEJY0XG';

    function readConsent() {
      try {
        var raw = localStorage.getItem(KEY);
        if (!raw) return null;
        var parsed = JSON.parse(raw);
        if (!parsed || parsed.version !== VERSION) return null;
        return parsed;
      } catch (e) {
        return null;
      }
    }
    function writeConsent(analytics) {
      var record = {
        version: VERSION,
        decided_at: new Date().toISOString(),
        analytics: !!analytics,
      };
      try {
        localStorage.setItem(KEY, JSON.stringify(record));
      } catch (e) {}
      return record;
    }
    // GA respects a window flag named after the measurement ID. Set before or
    // after gtag loads, it stops all sending — this is the documented opt-out
    // and the only thing that works on an already-initialised tag.
    function disableGA4() {
      window['ga-disable-' + GA_ID] = true;
      var host = location.hostname;
      var domains = ['', host, '.' + host];
      var bare = host.split('.').slice(-2).join('.');
      if (bare !== host) domains.push('.' + bare);
      document.cookie.split(';').forEach(function (raw) {
        var name = raw.split('=')[0].trim();
        if (name !== '_ga' && name.indexOf('_ga_') !== 0) return;
        domains.forEach(function (d) {
          document.cookie =
            name + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/' +
            (d ? '; domain=' + d : '');
        });
      });
    }
    function loadGA4() {
      if (window.__pm_ga4_loaded) return;
      window.__pm_ga4_loaded = true;
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () {
        window.dataLayer.push(arguments);
      };
      window.gtag('js', new Date());
      window.gtag('config', GA_ID);
    }
    function setHidden(id, hidden) {
      var el = document.getElementById(id);
      if (!el) return;
      if (hidden) el.setAttribute('hidden', '');
      else el.removeAttribute('hidden');
    }
    function showModal() {
      setHidden('pm-cookie-modal', false);
      var c = readConsent();
      var toggle = document.getElementById('pm-cookie-toggle-analytics');
      if (toggle) toggle.checked = c ? !!c.analytics : false;
    }
    // Dismiss without saving. The stored record is untouched, so an accidental
    // open can't silently change anything.
    function closeModal() {
      setHidden('pm-cookie-modal', true);
    }
    function applyConsent(consent) {
      if (consent && consent.analytics) loadGA4();
    }

    document.addEventListener('click', function (e) {
      var target = e.target;
      if (!target || !target.matches) return;
      if (target.matches('#pm-cookie-accept-all')) {
        var c = writeConsent(true);
        applyConsent(c);
        setHidden('pm-cookie-banner', true);
      } else if (target.matches('#pm-cookie-essential')) {
        writeConsent(false);
        setHidden('pm-cookie-banner', true);
      } else if (target.matches('#pm-cookie-close')) {
        closeModal();
      } else if (target.matches('#pm-cookie-modal')) {
        // Backdrop itself, not the panel — panel clicks don't bubble to here
        closeModal();
      } else if (target.matches('#pm-cookie-save')) {
        var toggle = document.getElementById('pm-cookie-toggle-analytics');
        var wanted = !!(toggle && toggle.checked);
        var had = readConsent();
        var c2 = writeConsent(wanted);
        setHidden('pm-cookie-banner', true);
        closeModal();
        // Withdrawal: gtag is already running, so stop it and drop its cookies.
        // Reload is the honest option — it guarantees nothing queued survives.
        if (!wanted && had && had.analytics) {
          disableGA4();
          location.reload();
          return;
        }
        applyConsent(c2);
      } else if (target.closest && target.closest('[data-pm-cookie-open]')) {
        e.preventDefault();
        showModal();
      }
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeModal();
    });

    var existing = readConsent();
    if (existing) {
      applyConsent(existing);
    } else {
      setHidden('pm-cookie-banner', false);
    }
  })();
</script>

<style>
  /* Banner — right-bottom corner card */
  .pm-cookie-banner {
    position: fixed;
    right: 16px;
    bottom: 16px;
    width: 360px;
    max-width: calc(100vw - 32px);
    z-index: 9000;
    background: #fff;
    border: 1px solid #eee;
    border-top: 3px solid #ff9900;
    border-radius: 10px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
    padding: 18px 20px;
    font-family: 'DM Sans', sans-serif;
    color: #222;
  }
  .pm-cookie-banner[hidden] {
    display: none;
  }
  .pm-cookie-banner__inner {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .pm-cookie-banner__text {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.5;
  }
  .pm-cookie-banner__text strong {
    color: #222;
  }
  .pm-cookie-banner__actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* Buttons */
  .pm-cookie-btn {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 9px 16px;
    border-radius: 6px;
    border: 2px solid transparent;
    cursor: pointer;
    transition: all 0.15s;
    line-height: 1.2;
  }
  .pm-cookie-btn--primary {
    background: #ff9900;
    border-color: #ff9900;
    color: #fff;
  }
  .pm-cookie-btn--primary:hover {
    background: #e68a00;
    border-color: #e68a00;
  }
  .pm-cookie-btn--ghost {
    background: transparent;
    border-color: #aaa;
    color: #444;
  }
  .pm-cookie-btn--ghost:hover {
    background: #f4f4f3;
    color: #222;
  }

  /* Modal */
  .pm-cookie-modal {
    position: fixed;
    inset: 0;
    z-index: 9500;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }
  .pm-cookie-modal[hidden] {
    display: none;
  }
  .pm-cookie-modal__panel {
    position: relative;
    background: #fff;
    border-radius: 12px;
    padding: 28px;
    max-width: 580px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    font-family: 'DM Sans', sans-serif;
    color: #222;
  }
  .pm-cookie-modal__title {
    margin: 0 0 6px;
    padding-right: 36px;
    font-size: 1.4rem;
    font-weight: 800;
  }
  .pm-cookie-modal__close {
    position: absolute;
    top: 14px;
    right: 16px;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    border-radius: 6px;
    font-size: 1.6rem;
    line-height: 1;
    color: #888;
    cursor: pointer;
    transition: all 0.15s;
  }
  .pm-cookie-modal__close:hover {
    background: #f4f4f3;
    color: #222;
  }
  .pm-cookie-modal__intro {
    margin: 0 0 20px;
    font-size: 0.95rem;
    color: #555;
  }

  .pm-cookie-cat {
    border: 1px solid #eee;
    border-radius: 8px;
    padding: 14px 16px;
    margin-bottom: 12px;
  }
  .pm-cookie-cat__head {
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    margin: 0;
  }
  .pm-cookie-cat__head input {
    margin: 0;
    width: 18px;
    height: 18px;
    accent-color: #ff9900;
  }
  .pm-cookie-cat__head input:disabled {
    cursor: not-allowed;
  }
  .pm-cookie-cat__head strong {
    font-size: 1rem;
    font-weight: 700;
  }
  .pm-cookie-cat__desc {
    margin: 6px 0 0 28px;
    font-size: 0.88rem;
    color: #555;
    line-height: 1.5;
  }
  .pm-cookie-cat__note {
    margin: 8px 0 0 28px;
    font-size: 0.82rem;
    color: #777;
    font-style: italic;
    line-height: 1.5;
  }

  .pm-cookie-modal__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 18px;
    flex-wrap: wrap;
  }
  .pm-cookie-modal__privacy {
    color: #ff9900;
    font-size: 0.88rem;
    text-decoration: underline;
  }
  .pm-cookie-modal__privacy:hover {
    color: #e68a00;
  }

  /* Mobile — card stretches but stays in corner */
  @media (max-width: 480px) {
    .pm-cookie-banner {
      right: 8px;
      bottom: 8px;
      left: 8px;
      width: auto;
      padding: 16px;
    }
    .pm-cookie-modal__panel {
      padding: 20px;
    }
  }
</style>
