---
// MysteryHelpBlock.astro
//
// Landing-page section that surfaces unidentified mystery photos to encourage
// community help. Renders only when there are photos awaiting identification.
//
// Data source: GET /api/mystery/featured
//   Returns { count: N, photos: [{ id, thumb_data }, ...] }  (max 6 photos)
//
// Behavior:
//   - count === 0   → block hides itself entirely (no visible DOM)
//   - count > 0     → block renders with thumbnails, count, and CTA
//
// Layout follows the other landing sections: h2 + CTA pill in a header row,
// description below, then a full-width thumbnail grid. Each thumbnail links to
// the language-appropriate identify page.
//
// Props:
//   lang: "fi" | "en"  — controls UI text. Defaults to "fi".
//
// Background and padding come from the landing pages' section rhythm.
//
// IMPORTANT: <style is:global> is required because the thumbnail DOM is created
// at runtime by the inline script. Astro's default style scoping wouldn't reach
// those JS-injected elements, so the .mhb-thumb sizing rules wouldn't apply.

const { lang = 'fi' } = Astro.props;

const STRINGS = {
  fi: {
    headline: 'Tunnetko näitä kuvia?',
    subline: 'Vanhoja moottoriurheilukuvia odottaa tunnistamista.',
    trustline: 'Ei rekisteröitymistä. Kommentoi nimettömästi tai omalla nimelläsi.',
    countSingular: 'kuva odottaa tunnistamista',
    countPlural: 'kuvaa odottaa tunnistamista',
    cta: 'Auta tunnistamaan →',
    thumbLabel: 'Auta tunnistamaan kuva {n}',
  },
  en: {
    headline: 'Do you recognize any of these photos?',
    subline: 'Old motorsport photos are waiting to be identified.',
    trustline: 'No registration. Comment anonymously or with your name.',
    countSingular: 'photo waiting to be identified',
    countPlural: 'photos waiting to be identified',
    cta: 'Help identify →',
    thumbLabel: 'Help identify photo {n}',
  },
};

const t = STRINGS[lang] || STRINGS.fi;
const href = lang === 'en' ? '/en/identify' : '/fi/tunnistamatta';
---

<section class="section mhb" id="mhbRoot" style="display:none;" data-lang={lang}>
  <div class="container">
    <div class="mhb-header">
      <h2 class="mhb-headline">{t.headline}</h2>
      <a href={href} class="mhb-cta">{t.cta}</a>
    </div>
    <p class="mhb-subline">{t.subline}</p>
    <p class="mhb-trustline">{t.trustline}</p>

    <div class="mhb-thumbs" id="mhbThumbs">
      {/* thumbs injected here by script */}
    </div>

    <p class="mhb-count" id="mhbCount"></p>
  </div>
</section>

<script is:inline define:vars={{ countSingular: t.countSingular, countPlural: t.countPlural, href, thumbLabel: t.thumbLabel }}>
// Deferred until the browser is idle. This block sits well below the fold, but
// the fetch used to fire during page load and compete with the hero image and
// fonts for bandwidth. Nothing above the fold depends on it, so it waits.
function mhbStart(cb) {
  if (document.readyState === 'complete') {
    (window.requestIdleCallback || ((f) => setTimeout(f, 200)))(cb);
  } else {
    window.addEventListener('load', () => {
      (window.requestIdleCallback || ((f) => setTimeout(f, 200)))(cb);
    }, { once: true });
  }
}

mhbStart(async function(){
  try {
    const r = await fetch('/api/mystery/featured');
    if (!r.ok) return;
    const data = await r.json();
    if (!data || !data.count || data.count < 1) return;

    const root = document.getElementById('mhbRoot');
    const thumbsEl = document.getElementById('mhbThumbs');
    const countEl = document.getElementById('mhbCount');
    if (!root || !thumbsEl || !countEl) return;

    const photos = (data.photos || []).filter(p => p && p.thumb_data);
    if (photos.length === 0) {
      thumbsEl.style.display = 'none';
    } else {
      thumbsEl.innerHTML = photos.map((p, i) =>
        '<a class="mhb-thumb" href="' + href + '" aria-label="' +
        thumbLabel.replace('{n}', String(i + 1)) + '">' +
        '<img src="' + p.thumb_data + '" alt="" loading="lazy" />' +
        '</a>'
      ).join('');
    }

    const label = data.count === 1 ? countSingular : countPlural;
    countEl.textContent = data.count + ' ' + label;

    root.style.display = '';
  } catch (e) {
    // Silent fail — block stays hidden
  }
});
</script>

<style is:global>
/* Same header row as the other landing sections (h2 left, CTA pill right). */
.mhb-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-3);
  margin-bottom: var(--space-2);
}
/* Matches .cta-section__heading ("Ota yhteyttä"). */
.mhb-headline {
  font-family: var(--font-headline);
  font-size: 1.75rem;
  font-weight: 900;
  color: var(--text-primary);
  margin: 0;
}
.mhb-cta {
  font-family: var(--font-headline);
  font-size: 0.85rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: #141414;
  background: var(--brand-primary);
  text-decoration: none;
  white-space: nowrap;
  border: none;
  border-radius: 999px;
  padding: 8px 18px;
  transition: background var(--transition-fast);
}
.mhb-cta:hover {
  background: var(--brand-primary-hover);
  color: #141414;
  text-decoration: none;
}
/* Matches .section-subheading on the landing pages. */
.mhb-subline {
  font-family: var(--font-headline);
  font-size: 1.35rem;
  font-weight: 600;
  color: var(--text-secondary);
  line-height: 1.3;
  margin: 0;
}
.mhb-trustline {
  font-family: var(--font-body);
  font-size: .85rem;
  /* #6B6B6B (~4.8:1 on cream/white) for AA. */
  color: #6B6B6B;
  margin: 6px 0 var(--space-4);
  line-height: 1.4;
  font-style: italic;
}
.mhb-thumbs {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: var(--space-2);
}
.mhb-thumb {
  display: block;
  aspect-ratio: 1 / 1;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: #eee;
  transition: transform .2s ease, box-shadow .2s ease;
}
.mhb-thumb:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 14px rgba(0,0,0,.12);
}
.mhb-thumb:focus-visible {
  outline: 3px solid var(--brand-primary);
  outline-offset: 2px;
}
.mhb-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.mhb-count {
  font-family: var(--font-body);
  font-size: .9rem;
  color: #6B6B6B;
  margin: var(--space-2) 0 0;
}

@media (max-width: 900px) {
  .mhb-thumbs {
    grid-template-columns: repeat(3, 1fr);
  }
}
@media (max-width: 540px) {
  .mhb-headline {
    font-size: 1.4rem;
  }
  .mhb-thumbs {
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }
}
</style>
